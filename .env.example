# =============================================================================
# Proofa Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values
# For local development, also create .env.local with Docker service URLs
# =============================================================================

# -----------------------------------------------------------------------------
# Database (Turso/LibSQL)
# -----------------------------------------------------------------------------
# Production: Use Turso cloud URL
# Local dev: Use http://localhost:8080 (from docker-compose)
DATABASE_URL=libsql://your-db-name.turso.io
DATABASE_AUTH_TOKEN=your-turso-auth-token

# -----------------------------------------------------------------------------
# Redis (Upstash)
# -----------------------------------------------------------------------------
# Production: Use Upstash cloud URL
# Local dev: Use http://localhost:8079 (from docker-compose)
UPSTASH_REDIS_REST_URL=https://your-redis-id.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# -----------------------------------------------------------------------------
# Email (Resend)
# -----------------------------------------------------------------------------
# Get your API key from https://resend.com
# Local dev: Uses Mailpit at http://localhost:8025
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=noreply@yourdomain.com
SEND_EMAILS=false

# -----------------------------------------------------------------------------
# OAuth Providers
# -----------------------------------------------------------------------------
# Google OAuth - https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# GitHub OAuth - https://github.com/settings/developers
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# -----------------------------------------------------------------------------
# Service URLs (Development Ports)
# -----------------------------------------------------------------------------
# User Dashboard:  http://localhost:3001
# Admin Dashboard: http://localhost:3002
# Core API:        http://localhost:3003
# Gateway BFF:     http://localhost:3004
# Home (Astro):    http://localhost:4321

# Core API
CORE_URL=http://localhost:3003
CALLBACK_URL=http://localhost:3003/v1/auth/callback

# Gateway BFF
GATEWAY_URL=http://localhost:3004

# -----------------------------------------------------------------------------
# Security Secrets
# -----------------------------------------------------------------------------
# Generate with: openssl rand -base64 48
CORE_S2S_TOKEN=your-s2s-token-generate-with-openssl-rand-base64-48
SESSION_SECRET=your-session-secret-generate-with-openssl-rand-base64-48

# -----------------------------------------------------------------------------
# Frontend Environment Variables (Vite)
# -----------------------------------------------------------------------------
# These are exposed to the browser, prefixed with VITE_
VITE_GATEWAY_URL=http://localhost:3004
VITE_CORE_URL=http://localhost:3003

# -----------------------------------------------------------------------------
# Environment
# -----------------------------------------------------------------------------
NODE_ENV=development
