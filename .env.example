# Proofa Environment Configuration Template
# Copy this file to .env and update with your values
# For local overrides, create a .env.local file (loads after .env)

# =============================================================================
# DATABASE
# =============================================================================
DATABASE_URL=postgresql://proofa:proofa@localhost:5432/proofa

# =============================================================================
# REDIS
# =============================================================================
REDIS_URL=redis://localhost:6379

# =============================================================================
# EMAIL SERVICE (Resend)
# =============================================================================
# Get free API key from https://resend.com
RESEND_API_KEY=re_123456789

# For local development with Mailpit:
# RESEND_API_KEY=re_test_key
# SMTP_HOST=localhost
# SMTP_PORT=1025

# =============================================================================
# ENCRYPTION
# =============================================================================
# Generate a secure key using:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your_64_character_hex_string_here

# =============================================================================
# OAUTH PROVIDERS (Platform Defaults - Optional)
# =============================================================================
# These are platform-level defaults
# Can be overridden at project and app levels

# Google OAuth
# Get credentials from: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth
# Get credentials from: https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# =============================================================================
# APPLICATION URLS
# =============================================================================
GATEWAY_URL=http://localhost:3000
DASHBOARD_URL=http://localhost:5173
USER_PORTAL_URL=http://localhost:5174

# =============================================================================
# OPTIONAL SETTINGS
# =============================================================================
# Node environment
NODE_ENV=development

# Port configuration (if needed)
# PORT=3000
# ADMIN_DASHBOARD_PORT=5173
# USER_PORTAL_PORT=5174

# Logging level
# LOG_LEVEL=info
