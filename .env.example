# Proofa Environment Configuration
# Copy this file to .env and fill in your values
# See LOCAL_DEVELOPMENT.md for detailed setup instructions

# ==========================================
# DATABASE
# ==========================================
# PostgreSQL connection string
DATABASE_URL=postgresql://proofa:proofa@localhost:5432/proofa

# ==========================================
# REDIS
# ==========================================
# Redis connection URL
REDIS_URL=redis://localhost:6379

# ==========================================
# ENCRYPTION
# ==========================================
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# ==========================================
# EMAIL SERVICE
# ==========================================
RESEND_API_KEY=
EMAIL_FROM=noreply@proofa.sh

# ==========================================
# PLATFORM OAUTH (Optional)
# ==========================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ==========================================
# GATEWAY SERVICE
# ==========================================
PORT=3000
NODE_ENV=development
COOKIE_DOMAIN=
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ==========================================
# SERVICE TOKENS
# ==========================================
CORE_URL=http://localhost:3001
X_PROOFA_SERVICE_TOKEN=
GATEWAY_S2S_TOKEN=

# ==========================================
# RATE LIMITING
# ==========================================
MAX_LOGIN_ATTEMPTS=5
MAX_REQUESTS_PER_MINUTE=100

# ==========================================
# LOGGING
# ==========================================
LOG_LEVEL=info

# Docker PostgreSQL Configuration
POSTGRES_DB=proofa
POSTGRES_USER=proofa
POSTGRES_PASSWORD=change_this_in_env_local
