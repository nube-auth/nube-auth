# ============================================================================
# Proofa Environment Configuration
# ============================================================================
# This file contains ALL environment variables with base/production values.
# For local development, create .env.local to override these values.
#
# IMPORTANT: Never commit .env or .env.local to version control!
# ============================================================================

# ----------------------------------------------------------------------------
# Database (PostgreSQL)
# ----------------------------------------------------------------------------
# Production format: postgresql://user:password@host:5432/database?sslmode=require
DATABASE_URL=postgresql://user:password@host:5432/proofa

# PostgreSQL credentials (used by docker-compose)
POSTGRES_DB=proofa
POSTGRES_USER=proofa
POSTGRES_PASSWORD=changeme

# ----------------------------------------------------------------------------
# Redis (Cache & Sessions)
# ----------------------------------------------------------------------------
# Production format: redis://default:password@host:6379
# Local format: redis://localhost:6379
REDIS_URL=redis://localhost:6379

# ----------------------------------------------------------------------------
# Authentication & Security (REQUIRED)
# ----------------------------------------------------------------------------
# Generate a 32-byte (64 hex chars) encryption key
# Command: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=changeme

# Generate a 64-byte (128 hex chars) session secret
# Command: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=changeme

# ----------------------------------------------------------------------------
# Email Service (REQUIRED)
# ----------------------------------------------------------------------------
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=re_...

# Email configuration
RESEND_FROM_EMAIL=noreply@yourdomain.com
RESEND_FROM_NAME=Proofa

# ----------------------------------------------------------------------------
# OAuth Providers (Optional - Platform Defaults)
# ----------------------------------------------------------------------------
# These are OPTIONAL - you can configure per project/app in admin dashboard
# Google OAuth: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth: https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ----------------------------------------------------------------------------
# Service URLs
# ----------------------------------------------------------------------------
# Production URLs
GATEWAY_URL=https://api.proofa.sh
CORE_URL=https://core.proofa.sh
ADMIN_DASHBOARD_URL=https://manage.proofa.sh
USER_DASHBOARD_URL=https://user.proofa.sh
HOME_URL=https://proofa.sh
DOCS_URL=https://docs.proofa.sh

# ----------------------------------------------------------------------------
# Cookies & CORS
# ----------------------------------------------------------------------------
# Production: .proofa.sh (allows all subdomains)
# Local: localhost
COOKIE_DOMAIN=.proofa.sh
COOKIE_SECURE=true

# Comma-separated list of allowed origins
CORS_ORIGINS=https://proofa.sh,https://manage.proofa.sh,https://user.proofa.sh

# ----------------------------------------------------------------------------
# Service-to-Service Authentication (REQUIRED)
# ----------------------------------------------------------------------------
# Generate secure tokens for S2S communication
# Command: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NOTE: X_PROOFA_SERVICE_TOKEN MUST match between Core + Gateway.
GATEWAY_S2S_TOKEN=changeme
CORE_S2S_TOKEN=changeme
X_PROOFA_SERVICE_TOKEN=changeme

# ----------------------------------------------------------------------------
# Logging
# ----------------------------------------------------------------------------
# Options: error, warn, info, debug, trace
LOG_LEVEL=info
NODE_ENV=production

# ----------------------------------------------------------------------------
# Payment Providers (Optional)
# ----------------------------------------------------------------------------
# Stripe: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Lemon Squeezy: https://app.lemonsqueezy.com/settings/api
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=

# Dodo Payments
DODO_API_KEY=
DODO_WEBHOOK_SECRET=

# ----------------------------------------------------------------------------
# Feature Flags (Optional)
# ----------------------------------------------------------------------------
ENABLE_REGISTRATION=true
ENABLE_MAGIC_LINKS=true
ENABLE_OAUTH=true
ENABLE_INVITATIONS=true

# ----------------------------------------------------------------------------
# Rate Limiting (Optional)
# ----------------------------------------------------------------------------
# Auth endpoints: requests per window
RATE_LIMIT_AUTH=10
# API endpoints: requests per window
RATE_LIMIT_API=100
# Window size in seconds
RATE_LIMIT_WINDOW=60
# Maximum login attempts before rate limit (default: 5)
MAX_LOGIN_ATTEMPTS=5
# Login attempt window in seconds (default: 900 = 15 minutes)
LOGIN_ATTEMPT_WINDOW=900
# Maximum requests per minute (default: 100)
MAX_REQUESTS_PER_MINUTE=100
# Maximum email verification attempts (default: 3)
MAX_EMAIL_ATTEMPTS=3
# Maximum OAuth callback attempts (default: 3)
MAX_OAUTH_ATTEMPTS=3

# ----------------------------------------------------------------------------
# Session Configuration (Optional)
# ----------------------------------------------------------------------------
# Session TTL in seconds (default: 31536000 = 365 days)
SESSION_TTL=31536000
# Refresh threshold in seconds (default: 1 day)
SESSION_REFRESH_THRESHOLD=86400
# JWT TTL in seconds (default: 3600 = 1 hour)
JWT_TTL=3600
# Email verification code TTL in seconds (default: 600 = 10 minutes)
EMAIL_CODE_TTL=600
# OAuth state TTL in seconds (default: 600 = 10 minutes)
OAUTH_STATE_TTL=600
# Token expiry buffer in seconds (default: 60 = 1 minute)
TOKEN_EXPIRY_BUFFER=60
# Refresh token TTL in seconds (default: 604800 = 7 days for Gateway, 2592000 = 30 days for Core)
REFRESH_TOKEN_TTL=604800
# Project invitation expiry in days (default: 7)
INVITATION_EXPIRY_DAYS=7

# Security - Token/Session generation
# Session ID generation - number of random bytes (default: 32 = 256 bits)
SESSION_ID_BYTES=32
# CSRF token generation - number of random bytes (default: 32 = 256 bits)
CSRF_TOKEN_BYTES=32

# ----------------------------------------------------------------------------
# Database Connection Pool (Optional)
# ----------------------------------------------------------------------------
DB_POOL_MIN=5
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT=30000
DB_POOL_CONNECTION_TIMEOUT=2000

# ----------------------------------------------------------------------------
# Redis Configuration (Optional)
# ----------------------------------------------------------------------------
REDIS_POOL_MIN=5
REDIS_POOL_MAX=20
CACHE_TTL=3600

# ----------------------------------------------------------------------------
# Security Headers (Optional)
# ----------------------------------------------------------------------------
# Content Security Policy
CSP_ENABLED=true
# HTTP Strict Transport Security max age
HSTS_MAX_AGE=31536000

# ----------------------------------------------------------------------------
# Monitoring & Analytics (Optional)
# ----------------------------------------------------------------------------
# Sentry DSN for error tracking
SENTRY_DSN=

# PostHog for analytics
POSTHOG_API_KEY=
POSTHOG_HOST=

# ----------------------------------------------------------------------------
# Development Tools (Local Only)
# ----------------------------------------------------------------------------
# These should be disabled in production
ENABLE_DRIZZLE_STUDIO=false
ENABLE_REDIS_COMMANDER=false
ENABLE_MAILPIT=false
