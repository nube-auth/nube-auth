# ============================================================================
# Nube Auth — Environment Configuration (Example / Template)
# ============================================================================
# This file contains all environment variables needed to run Nube Auth.
# For local development, create .env.local to override these values.
#
# IMPORTANT: Never commit .env or .env.local to version control!
# ============================================================================

# ----------------------------------------------------------------------------
# Application
# ----------------------------------------------------------------------------
NODE_ENV=production
CORE_PORT=3003
GATEWAY_PORT=3004
LOG_LEVEL=info

# ----------------------------------------------------------------------------
# Database (PostgreSQL)
# ----------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@host:5432/proofa

# PostgreSQL credentials (used by docker-compose only)
POSTGRES_DB=proofa
POSTGRES_USER=proofa
POSTGRES_PASSWORD=changeme

# ----------------------------------------------------------------------------
# Redis (Cache & Sessions)
# ----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ----------------------------------------------------------------------------
# Authentication & Security (REQUIRED)
# ----------------------------------------------------------------------------
# Generate a 32-byte (64 hex chars) encryption key
# Command: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=changeme

# Generate a 64-byte (128 hex chars) session secret
# Command: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Shared by both Core and Gateway services
SESSION_SECRET=changeme

# JWT Secret for Core service - 32 bytes (64 hex chars)
# Command: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=changeme

# ----------------------------------------------------------------------------
# Service-to-Service Authentication (REQUIRED)
# ----------------------------------------------------------------------------
# Generate secure tokens for S2S communication - 32 bytes (64 hex chars) each
# Command: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NOTE: These tokens MUST match between Core + Gateway
S2S_SECRET=changeme
X_NUBE_AUTH_SERVICE_TOKEN=changeme

# ----------------------------------------------------------------------------
# Service URLs
# ----------------------------------------------------------------------------
CORE_URL=http://localhost:3003
CORE_PUBLIC_URL=http://localhost:3003
GATEWAY_PUBLIC_URL=http://localhost:3004
ADMIN_DASHBOARD_URL=http://localhost:5174
USER_DASHBOARD_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
COOKIE_DOMAIN=
COOKIE_NAMESPACE=

# Dashboard build-time vars (Vite)
VITE_GATEWAY_URL=http://localhost:3004
VITE_HOME_URL=http://localhost:4321
VITE_DOCS_URL=http://localhost:4322
VITE_ENV_TAG=Beta
VITE_COOKIE_NAMESPACE=

# Home dashboard build-time vars (Astro)
PUBLIC_DOCS_URL=http://localhost:4322
PUBLIC_ENV_TAG=Beta

# Core webhook callback base URL (defaults to CORE_PUBLIC_URL if unset)
API_BASE_URL=http://localhost:3003

# ----------------------------------------------------------------------------
# Email Service (REQUIRED)
# ----------------------------------------------------------------------------
# Nube Auth Email API (template-based). Sends via POST {BASE_URL}/v1/send.
EMAIL_API_KEY=your-email-api-key
EMAIL_API_BASE_URL=https://your-emailflare.com
EMAIL_THEME_ID=default
EMAIL_FROM=hello@yourdomain.com
SEND_EMAILS=true

# ----------------------------------------------------------------------------
# OAuth Providers (Optional — Platform Defaults)
# ----------------------------------------------------------------------------
# These are OPTIONAL — you can configure per project/app in admin dashboard
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Comma-separated list of allowed OAuth redirect origins (Core service)
ALLOWED_REDIRECT_ORIGINS=http://localhost:3004,http://localhost:5173,http://localhost:5174

# ----------------------------------------------------------------------------
# Session & Token TTL (Optional — Defaults shown in comments)
# ----------------------------------------------------------------------------
CORE_SESSION_TTL_SECONDS=31536000         # 365 days
SESSION_REFRESH_THRESHOLD_SECONDS=2592000 # 30 days
SESSION_TTL_SECONDS=31536000              # 365 days
ADMIN_SESSION_TTL_SECONDS=7200            # 2 hours
ADMIN_INACTIVITY_TIMEOUT_SECONDS=900      # 15 minutes
INVITATION_EXPIRY_SECONDS=604800          # 7 days
JWT_TTL_SECONDS=3600                      # 1 hour
EMAIL_CODE_TTL_SECONDS=600                # 10 minutes
OAUTH_STATE_TTL_SECONDS=600               # 10 minutes
TOKEN_EXPIRY_BUFFER_SECONDS=60            # 1 minute
REFRESH_TOKEN_TTL_SECONDS=604800          # 7 days (Gateway default)
CACHE_TTL_SECONDS=3600                    # 1 hour

# ----------------------------------------------------------------------------
# Security — Token Generation (Optional)
# ----------------------------------------------------------------------------
SESSION_ID_BYTES=32
CSRF_TOKEN_BYTES=32

# ----------------------------------------------------------------------------
# Rate Limiting (Optional)
# ----------------------------------------------------------------------------
RATE_LIMIT_WINDOW_SECONDS=60
MAX_LOGIN_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW_SECONDS=900
MAX_REQUESTS_PER_MINUTE=100
MAX_EMAIL_ATTEMPTS=3
MAX_OAUTH_ATTEMPTS=3

# ----------------------------------------------------------------------------
# Payment Providers (Optional)
# ----------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
LEMONSQUEEZY_API_KEY=
DODO_API_KEY=

# Encryption key for payment provider credentials (32 bytes, 64 hex chars)
PAYMENT_CONFIGS_KEY=
