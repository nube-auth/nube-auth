# ============================================================================
# Proofa Environment Configuration
# ============================================================================
# This file contains ALL environment variables with base/production values.
# For local development, create .env.local to override these values.
#
# IMPORTANT: Never commit .env or .env.local to version control!
# ============================================================================

# ----------------------------------------------------------------------------
# Application
# ----------------------------------------------------------------------------
NODE_ENV=production
CORE_PORT=3003
GATEWAY_PORT=3004
LOG_LEVEL=info

# ----------------------------------------------------------------------------
# Database (PostgreSQL)
# ----------------------------------------------------------------------------
# Production format: postgresql://user:password@host:5432/database?sslmode=require
DATABASE_URL=postgresql://user:password@host:5432/proofa

# PostgreSQL credentials (used by docker-compose only)
POSTGRES_DB=proofa
POSTGRES_USER=proofa
POSTGRES_PASSWORD=changeme

# ----------------------------------------------------------------------------
# Redis (Cache & Sessions)
# ----------------------------------------------------------------------------
# Production format: redis://default:password@host:6379
# Local format: redis://localhost:6379
REDIS_URL=redis://localhost:6379

# ----------------------------------------------------------------------------
# Authentication & Security (REQUIRED)
# ----------------------------------------------------------------------------
# Generate a 32-byte (64 hex chars) encryption key
# Command: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=changeme

# Generate a 64-byte (128 hex chars) session secret
# Command: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=changeme

# JWT Secret for Core service - 32 bytes (64 hex chars)
# Command: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=changeme

# Gateway session secret - 64 bytes (128 hex chars)
# Command: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=changeme

# ----------------------------------------------------------------------------
# Service-to-Service Authentication (REQUIRED)
# ----------------------------------------------------------------------------
# Generate secure tokens for S2S communication - 32 bytes (64 hex chars) each
# Command: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NOTE: These tokens MUST match between Core + Gateway
S2S_SECRET=changeme
CORE_S2S_TOKEN=changeme
X_PROOFA_SERVICE_TOKEN=changeme

# ----------------------------------------------------------------------------
# Service URLs
# ----------------------------------------------------------------------------
# Core service URL (internal)
CORE_URL=http://localhost:3003
CORE_PUBLIC_URL=http://localhost:3003

# Gateway service URL (public API)
GATEWAY_URL=http://localhost:3004
GATEWAY_PUBLIC_URL=http://localhost:3004

# Dashboard URLs
ADMIN_DASHBOARD_URL=http://localhost:5174
USER_DASHBOARD_URL=http://localhost:5173

# Marketing site URLs
HOME_URL=http://localhost:4321
DOCS_URL=http://localhost:4322

# For Vite apps (user/admin dashboards)
VITE_GATEWAY_URL=http://localhost:3004
VITE_CORE_URL=http://localhost:3003
VITE_HOME_URL=http://localhost:4321
VITE_DOCS_URL=http://localhost:4322

# ----------------------------------------------------------------------------
# Email Service (REQUIRED)
# ----------------------------------------------------------------------------
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=re_...

# Email configuration
RESEND_FROM_EMAIL=noreply@yourdomain.com
RESEND_FROM_NAME=Proofa
EMAIL_FROM=noreply@yourdomain.com
SEND_EMAILS=true

# SMTP for local email testing
# Automatically enabled when NODE_ENV=development
# In production/staging, Resend is used instead
SMTP_HOST=localhost
SMTP_PORT=1025

# ----------------------------------------------------------------------------
# OAuth Providers (Optional - Platform Defaults)
# ----------------------------------------------------------------------------
# These are OPTIONAL - you can configure per project/app in admin dashboard
# Google OAuth: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth: https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Callback URL for OAuth (Core service)
CALLBACK_URL=http://localhost:3003/v1/auth/callback

# ----------------------------------------------------------------------------
# Cookies & CORS
# ----------------------------------------------------------------------------
# Production: .proofa.sh (allows all subdomains)
# Local: localhost
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3003,http://localhost:3004,http://localhost:5173,http://localhost:5174,http://localhost:4321,http://localhost:4322

# ----------------------------------------------------------------------------
# Session Configuration (Optional)
# ----------------------------------------------------------------------------
# Core session TTL in seconds (default: 31536000 = 365 days)
# Controls how long the global core session lasts
CORE_SESSION_TTL_SECONDS=31536000

# Session refresh threshold in seconds (default: 2592000 = 30 days)
# Only extend session TTL if last activity was more than this threshold ago
# This prevents excessive database writes on every request
SESSION_REFRESH_THRESHOLD_SECONDS=2592000

# User session TTL in seconds (default: 31536000 = 365 days)
SESSION_TTL_SECONDS=31536000

# Admin session TTL in seconds (default: 7200 = 2 hours)
# Shorter TTL for elevated privileges
# Automatically set to 7 days in development mode (NODE_ENV=development)
ADMIN_SESSION_TTL_SECONDS=7200

# Admin inactivity timeout in seconds (default: 900 = 15 minutes)
# Admin sessions expire after this period of inactivity
# Automatically disabled in development mode (NODE_ENV=development)
ADMIN_INACTIVITY_TIMEOUT_SECONDS=900

# Invitation expiry in seconds (default: 604800 = 7 days)
INVITATION_EXPIRY_SECONDS=604800

# JWT TTL in seconds (default: 3600 = 1 hour)
JWT_TTL_SECONDS=3600

# Email verification code TTL in seconds (default: 600 = 10 minutes)
EMAIL_CODE_TTL_SECONDS=600

# OAuth state TTL in seconds (default: 600 = 10 minutes)
OAUTH_STATE_TTL_SECONDS=600

# Token expiry buffer in seconds (default: 60 = 1 minute)
TOKEN_EXPIRY_BUFFER_SECONDS=60

# Refresh token TTL in seconds (default: 604800 = 7 days for Gateway, 2592000 = 30 days for Core)
REFRESH_TOKEN_TTL_SECONDS=604800

# Cache TTL in seconds (default: 3600 = 1 hour)
CACHE_TTL_SECONDS=3600

# ----------------------------------------------------------------------------
# Security - Token/Session Generation
# ----------------------------------------------------------------------------
# Session ID generation - number of random bytes (default: 32 = 256 bits)
SESSION_ID_BYTES=32

# CSRF token generation - number of random bytes (default: 32 = 256 bits)
CSRF_TOKEN_BYTES=32

# ----------------------------------------------------------------------------
# Rate Limiting (Optional)
# ----------------------------------------------------------------------------
# Auth endpoints: requests per window
RATE_LIMIT_AUTH=10

# API endpoints: requests per window
RATE_LIMIT_API=100

# Window size in seconds
RATE_LIMIT_WINDOW_SECONDS=60

# Maximum login attempts before rate limit (default: 5)
MAX_LOGIN_ATTEMPTS=5

# Login attempt window in seconds (default: 900 = 15 minutes)
LOGIN_ATTEMPT_WINDOW_SECONDS=900

# Maximum requests per minute (default: 100)
MAX_REQUESTS_PER_MINUTE=100

# Maximum email verification attempts (default: 3)
MAX_EMAIL_ATTEMPTS=3

# Maximum OAuth callback attempts (default: 3)
MAX_OAUTH_ATTEMPTS=3

# ----------------------------------------------------------------------------
# Feature Flags (Optional)
# ----------------------------------------------------------------------------
ENABLE_REGISTRATION=true
ENABLE_MAGIC_LINKS=true
ENABLE_OAUTH=true
ENABLE_INVITATIONS=true

# ----------------------------------------------------------------------------
# Database Connection Pool (Optional)
# ----------------------------------------------------------------------------
DB_POOL_MIN=5
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=2000

# ----------------------------------------------------------------------------
# Payment Providers (Optional)
# ----------------------------------------------------------------------------
# Stripe: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Lemon Squeezy: https://app.lemonsqueezy.com/settings/api
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=

# Dodo Payments
DODO_API_KEY=
DODO_WEBHOOK_SECRET=

# ----------------------------------------------------------------------------
# Security Headers (Optional)
# ----------------------------------------------------------------------------
# Content Security Policy
CSP_ENABLED=true

# HTTP Strict Transport Security max age in seconds
HSTS_MAX_AGE_SECONDS=31536000

# ----------------------------------------------------------------------------
# Monitoring & Analytics (Optional)
# ----------------------------------------------------------------------------
# Sentry DSN for error tracking
SENTRY_DSN=

# PostHog for analytics
POSTHOG_API_KEY=
POSTHOG_HOST=

# ----------------------------------------------------------------------------
# Development Tools (Local Only)
# ----------------------------------------------------------------------------
# These should be disabled in production
ENABLE_DRIZZLE_STUDIO=false
