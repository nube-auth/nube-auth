# Database (Turso/LibSQL)
DATABASE_URL=libsql://your-db-name-xxx.turso.io
DATABASE_AUTH_TOKEN=your-auth-token

# Redis (Upstash)
UPSTASH_REDIS_REST_URL=https://your-redis-id.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# Email (Resend)
RESEND_API_KEY=your-resend-key
EMAIL_FROM=noreply@proofa.ai
SEND_EMAILS=false  # Set to true in production

# OAuth Providers
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Callback URLs
CALLBACK_URL=http://localhost:3001/v1/auth/callback

# Core App
CORE_URL=http://localhost:3001
CORE_S2S_TOKEN=your-s2s-token-generate-with-openssl-rand

# Session
SESSION_SECRET=your-session-secret-generate-with-openssl-rand

# Gateway (BFF)
GATEWAY_URL=http://localhost:3002

# User Dashboard
VITE_GATEWAY_URL=http://localhost:3002
VITE_CORE_URL=http://localhost:3001

# Admin Dashboard
VITE_GATEWAY_URL=http://localhost:3002
VITE_CORE_URL=http://localhost:3001
