# =============================================================================
# Proofa Environment Configuration
# =============================================================================
# Copy this file to .env.local and fill in the values
# For local development with Docker services, these defaults point to localhost
# =============================================================================

# -----------------------------------------------------------------------------
# Frontend URLs (Vite - exposed to browser)
# =============================================================================
# IMPORTANT: These must match your local service ports
# Local Dev Default: http://localhost:PORT
# Change these if you run services on different ports
# Production: Set these to your production URLs

# Gateway API (BFF server) - User & Admin Dashboard use this
VITE_GATEWAY_URL=http://localhost:3004

# Core API (Authentication service)
VITE_CORE_URL=http://localhost:3003

# Home page (Astro landing page)
VITE_HOME_URL=http://localhost:4321

# Documentation site (Starlight docs)
VITE_DOCS_URL=http://localhost:4322

# -----------------------------------------------------------------------------
# Database (Turso/LibSQL)
# =============================================================================
# Local Dev: Use http://localhost:8080 (from docker-compose)
# Production: Use your Turso cloud URL

DATABASE_URL=http://localhost:8080
DATABASE_AUTH_TOKEN=

# Production example (uncomment and fill in for production):
# DATABASE_URL=libsql://your-db-name.turso.io
# DATABASE_AUTH_TOKEN=your-turso-auth-token

# -----------------------------------------------------------------------------
# Redis (Upstash)
# =============================================================================
# Local Dev: Use http://localhost:8079 (Redis REST proxy from docker-compose)
# Production: Use your Upstash cloud URL

UPSTASH_REDIS_REST_URL=http://localhost:8079
UPSTASH_REDIS_REST_TOKEN=local-dev-token

# Production example (uncomment and fill in for production):
# UPSTASH_REDIS_REST_URL=https://your-redis-id.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# -----------------------------------------------------------------------------
# Email (Resend + Mailpit)
# =============================================================================
# Local Dev: Mailpit catches all emails at http://localhost:8025
# Production: Use Resend or your email service

RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=noreply@proofa.local
SEND_EMAILS=false

# Use this for local testing:
# MAILPIT_WEB_URL=http://localhost:8025

# Production example:
# SEND_EMAILS=true
# RESEND_API_KEY=re_your_production_api_key
# EMAIL_FROM=noreply@yourdomain.com

# -----------------------------------------------------------------------------
# OAuth Providers
# =============================================================================
# Local Dev: Use localhost:3003 for callback URLs
# Production: Use your production domain

# Google OAuth - https://console.cloud.google.com/apis/credentials
# Callback URL for local: http://localhost:3003/v1/auth/callback/google
# Callback URL for prod:  https://yourdomain.com/v1/auth/callback/google
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# GitHub OAuth - https://github.com/settings/developers
# Callback URL for local: http://localhost:3003/v1/auth/callback/github
# Callback URL for prod:  https://yourdomain.com/v1/auth/callback/github
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# =============================================================================
# Security Secrets
# =============================================================================
# Generate with: openssl rand -hex 32
# Keep these safe and unique per environment!

# JWT secret for signing tokens
JWT_SECRET=your-32-char-jwt-secret-generated-with-openssl-rand-hex-32

# Session secret for encrypting session data
SESSION_SECRET=your-32-char-session-secret-generated-with-openssl-rand-hex-32

# Service-to-Service authentication token for internal API calls
S2S_SECRET=your-32-char-s2s-secret-generated-with-openssl-rand-hex-32

# =============================================================================
# Application Configuration
# =============================================================================
NODE_ENV=development
LOG_LEVEL=debug

# If running services on different ports, update here:
# CORE_PORT=3003
# GATEWAY_PORT=3004
# USER_DASHBOARD_PORT=3001
# ADMIN_DASHBOARD_PORT=3002
