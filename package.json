{
	"name": "nube-auth",
	"version": "0.1.0",
	"description": "Nube Auth - Identity, sessions, and licensing for apps",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "turbo run dev",
		"dev:gateway": "pnpm --filter @nube-auth/gateway dev",
		"dev:core": "pnpm --filter @nube-auth/core dev",
		"dev:workers": "pnpm --filter @nube-auth/workers dev",
		"dev:admin": "pnpm --filter @nube-auth/dashboard-admin dev",
		"dev:user": "pnpm --filter @nube-auth/dashboard-user dev",
		"dev:home": "pnpm --filter @nube-auth/dashboard-home dev",
		"dev:docs": "pnpm --filter @nube-auth/dashboard-docs dev",
		"build": "turbo run build",
		"build:packages": "turbo build --filter='./apps/packages/*'",
		"test": "turbo run test",
		"lint": "biome lint .",
		"lint:fix": "biome lint --write --unsafe .",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"check": "biome check .",
		"check:fix": "biome check --max-diagnostics 100 --write .",
		"typecheck": "turbo run typecheck",
		"db:migrate": "turbo run db:migrate",
		"db:push": "pnpm --filter @nube-auth/db run db:push",
		"db:studio": "pnpm --filter @nube-auth/db run db:studio",
		"db:generate": "pnpm --filter @nube-auth/db run db:generate",
		"db:fresh": "pnpm --filter @nube-auth/db run db:fresh",
		"seed:project": "pnpm --filter @nube-auth/db run seed:project",
		"prepare": "husky"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.10",
		"@types/node": "^25.0.3",
		"@types/nodemailer": "^8.0.2",
		"@types/pg": "^8.11.10",
		"@types/react": "^18.3.27",
		"@vitejs/plugin-react": "^5.1.2",
		"concurrently": "^9.2.1",
		"dotenv": "^17.2.3",
		"dotenv-cli": "^11.0.0",
		"husky": "^9.1.7",
		"lint-staged": "^16.2.7",
		"tsx": "^4.7.0",
		"turbo": "^2.9.14",
		"typescript": "6.0.0-beta"
	},
	"engines": {
		"node": ">=22.0.0",
		"pnpm": ">=9.0.0"
	},
	"packageManager": "pnpm@9.15.9",
	"dependencies": {
		"@pingpong-js/fetch": "^1.0.2",
		"@tailwindcss/forms": "^0.5.7",
		"@tailwindcss/typography": "^0.5.10",
		"autoprefixer": "^10.4.17",
		"clsx": "^2.0.0",
		"pino": "^10.1.0",
		"pino-pretty": "^13.1.3",
		"postcss": "^8.4.32",
		"tailwind-merge": "^2.2.2",
		"tailwindcss": "^3.4.1"
	},
	"pnpm": {
		"overrides": {
			"undici": "7.29.1",
			"tar": "7.5.22",
			"ioredis": "5.8.2",
			"hono": "4.13.13",
			"@hono/node-server": "1.19.17",
			"nodemailer": "10.1.1",
			"drizzle-orm": "0.45.4",
			"turbo": "2.11.8",
			"react-router": "7.18.4",
			"react-router-dom": "7.18.4",
			"shell-quote": "1.12.0",
			"tinypool": "2.2.0",
			"brace-expansion@2": "2.1.7",
			"@isaacs/brace-expansion": "5.0.1",
			"browserslist": "4.29.3",
			"defu": "6.1.7",
			"fast-xml-parser": "5.11.2",
			"js-cookie": "3.0.8",
			"minimatch@9": "9.0.9",
			"minimatch@10": "10.2.6",
			"nanoid@3": "3.3.20",
			"nanoid@>=4": "5.1.16",
			"picomatch@2": "2.3.2",
			"picomatch@4": "4.0.7",
			"postcss": "8.5.30",
			"postcss-selector-parser": "7.1.6",
			"rollup": "4.64.7",
			"source-map-js": "1.2.2",
			"baseline-browser-mapping": "2.11.28",
			"fast-copy": "4.2.0",
			"qs": "6.16.1",
			"@babel/core": "7.29.7",
			"@vue/server-renderer": "3.5.44",
			"esbuild@<=0.24.2": "0.25.12",
			"uuid@11": "11.1.1",
			"vite@<=6.4.2": "6.4.4"
		}
	}
}
