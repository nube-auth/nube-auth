{
	"name": "nube-auth",
	"version": "0.1.0",
	"description": "Nube Auth - Identity, sessions, and licensing for apps",
	"private": true,
	"type": "module",
	"scripts": {
		"setup": "./nube-scripts/scripts/setup-dev.sh",
		"dev": "turbo run dev",
		"dev:gateway": "pnpm --filter @nube-auth/gateway dev",
		"dev:core": "pnpm --filter @nube-auth/core dev",
		"dev:workers": "pnpm --filter @nube-auth/workers dev",
		"dev:admin": "pnpm --filter @nube-auth/dashboard-admin dev",
		"dev:user": "pnpm --filter @nube-auth/dashboard-user dev",
		"dev:home": "pnpm --filter @nube-auth/dashboard-home dev",
		"dev:docs": "pnpm --filter @nube-auth/dashboard-docs dev",
		"build": "turbo run build",
		"build:packages": "turbo build --filter='./apps/packages/*'",
		"test": "turbo run test",
		"lint": "biome lint .",
		"lint:fix": "biome lint --write --unsafe .",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"check": "biome check .",
		"check:fix": "biome check --max-diagnostics 100 --write .",
		"typecheck": "turbo run typecheck",
		"db:migrate": "turbo run db:migrate",
		"db:push": "pnpm --filter @nube-auth/db run db:push",
		"db:studio": "pnpm --filter @nube-auth/db run db:studio",
		"db:generate": "pnpm --filter @nube-auth/db run db:generate",
		"db:fresh": "pnpm --filter @nube-auth/db run db:fresh",
		"seed:project": "pnpm --filter @nube-auth/db run seed:project",
		"docker:up": "./nube-scripts/scripts/deploy-local.sh up",
		"docker:up:all": "./nube-scripts/scripts/deploy-local.sh up:all",
		"docker:down": "./nube-scripts/scripts/deploy-local.sh down",
		"docker:logs": "./nube-scripts/scripts/deploy-local.sh logs",
		"docker:status": "./nube-scripts/scripts/deploy-local.sh status",
		"docker:clean": "./nube-scripts/scripts/deploy-local.sh clean",
		"prepare": "husky"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.10",
		"@types/node": "^25.0.3",
		"@types/nodemailer": "^7.0.4",
		"@types/pg": "^8.11.10",
		"@types/react": "^18.3.27",
		"@vitejs/plugin-react": "^5.1.2",
		"concurrently": "^9.2.1",
		"dotenv": "^17.2.3",
		"dotenv-cli": "^11.0.0",
		"husky": "^9.1.7",
		"lint-staged": "^16.2.7",
		"tsx": "^4.7.0",
		"turbo": "^2.8.12",
		"typescript": "6.0.0-beta"
	},
	"engines": {
		"node": ">=22.0.0",
		"pnpm": ">=9.0.0"
	},
	"packageManager": "pnpm@9.15.9",
	"dependencies": {
		"@astrojs/tailwind": "^6.0.0",
		"@pingpong-js/fetch": "^1.0.2",
		"@tailwindcss/forms": "^0.5.7",
		"@tailwindcss/typography": "^0.5.10",
		"autoprefixer": "^10.4.17",
		"clsx": "^2.0.0",
		"pino": "^10.1.0",
		"pino-pretty": "^13.1.3",
		"postcss": "^8.4.32",
		"tailwind-merge": "^2.2.2",
		"tailwindcss": "^3.4.1"
	},
	"pnpm": {
		"overrides": {
			"ioredis": "5.8.2"
		}
	}
}
