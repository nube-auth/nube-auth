# Local Environment Overrides
# Copy this file to .env.local to override values from .env
# This file is loaded AFTER .env, so values here take precedence
# .env.local is gitignored and should contain your personal/local settings

# =============================================================================
# LOCAL DATABASE OVERRIDE (Optional)
# =============================================================================
# Uncomment to use a different local database
# DATABASE_URL=postgresql://myuser:mypass@localhost:5432/proofa_local

# =============================================================================
# LOCAL REDIS OVERRIDE (Optional)
# =============================================================================
# Uncomment if you want to use a different Redis instance
# REDIS_URL=redis://localhost:6380

# =============================================================================
# LOCAL EMAIL TESTING (Recommended for development)
# =============================================================================
# Use Mailpit for local email testing
# Start Mailpit with: docker compose --profile email up mailpit
# RESEND_API_KEY=re_local_test_key
# SMTP_HOST=localhost
# SMTP_PORT=1025

# =============================================================================
# LOCAL OAUTH CREDENTIALS (Optional)
# =============================================================================
# Override with your personal OAuth credentials for testing
# GOOGLE_CLIENT_ID=your_local_google_client_id
# GOOGLE_CLIENT_SECRET=your_local_google_client_secret
# GITHUB_CLIENT_ID=your_local_github_client_id
# GITHUB_CLIENT_SECRET=your_local_github_client_secret

# =============================================================================
# LOCAL ENCRYPTION KEY (Optional)
# =============================================================================
# Use a different encryption key for local development
# ENCRYPTION_KEY=your_local_encryption_key

# =============================================================================
# LOCAL URLS (Optional)
# =============================================================================
# Override if running on different ports
# GATEWAY_URL=http://localhost:3001
# DASHBOARD_URL=http://localhost:5175

# =============================================================================
# DEBUG SETTINGS
# =============================================================================
# LOG_LEVEL=debug
# DEBUG=true
