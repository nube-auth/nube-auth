# ============================================================================
# Proofa Local Development Environment
# ============================================================================
# This file contains LOCAL OVERRIDES for development.
# Copy this to .env.local and it will override values from .env
# 
# Quick Start:
# 1. cp .env.local.example .env.local
# 2. Generate secrets: pnpm run setup:secrets
# 3. docker-compose up -d
# 4. pnpm dev
# ============================================================================

# ----------------------------------------------------------------------------
# Database (PostgreSQL)
# ----------------------------------------------------------------------------
# Local PostgreSQL connection (from docker-compose.yml)
DATABASE_URL=postgresql://proofa:proofa_dev_password@localhost:5432/proofa

# Override with your custom password if needed
POSTGRES_PASSWORD=proofa_dev_password

# ----------------------------------------------------------------------------
# Redis (Cache & Sessions)
# ----------------------------------------------------------------------------
# Local Redis connection (from docker-compose.yml)
REDIS_URL=redis://localhost:6379

# ----------------------------------------------------------------------------
# Authentication & Security
# ----------------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ----------------------------------------------------------------------------
# Email Service (Resend)
# ----------------------------------------------------------------------------
# Get your API key from: https://resend.com/api-keys
# For local dev, you can use test mode or leave empty
RESEND_API_KEY=re_123456789_YourResendAPIKey

# Email from address
RESEND_FROM_EMAIL=noreply@localhost
RESEND_FROM_NAME=Proofa (Local Dev)

# ----------------------------------------------------------------------------
# OAuth Providers (Platform Defaults - Optional)
# ----------------------------------------------------------------------------
# These are OPTIONAL - you can configure per project/app in the admin dashboard
# Get credentials from: https://console.cloud.google.com
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Get credentials from: https://github.com/settings/developers
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# ----------------------------------------------------------------------------
# Service URLs (Local Development)
# ----------------------------------------------------------------------------
GATEWAY_URL=http://localhost:3004
CORE_URL=http://localhost:3003
ADMIN_DASHBOARD_URL=http://localhost:5174
USER_DASHBOARD_URL=http://localhost:5173
HOME_URL=http://localhost:4321
DOCS_URL=http://localhost:4322

# ----------------------------------------------------------------------------
# Cookies & CORS
# ----------------------------------------------------------------------------
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# Allowed origins for CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3003,http://localhost:3004,http://localhost:5173,http://localhost:5174,http://localhost:4321,http://localhost:4322

# ----------------------------------------------------------------------------
# Service-to-Service Authentication
# ----------------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GATEWAY_S2S_TOKEN=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
CORE_S2S_TOKEN=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# NOTE: X_PROOFA_SERVICE_TOKEN MUST match between Core + Gateway.
X_PROOFA_SERVICE_TOKEN=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ----------------------------------------------------------------------------
# Logging
# ----------------------------------------------------------------------------
LOG_LEVEL=debug
NODE_ENV=development

# ----------------------------------------------------------------------------
# Optional: Payment Providers (for testing)
# ----------------------------------------------------------------------------
# Stripe Test Keys (get from: https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Lemon Squeezy Test Keys (get from: https://app.lemonsqueezy.com/settings/api)
LEMONSQUEEZY_API_KEY=...
LEMONSQUEEZY_STORE_ID=...
LEMONSQUEEZY_WEBHOOK_SECRET=...

# ----------------------------------------------------------------------------
# Optional: Feature Flags
# ----------------------------------------------------------------------------
ENABLE_REGISTRATION=true
ENABLE_MAGIC_LINKS=true
ENABLE_OAUTH=true
ENABLE_INVITATIONS=true

# ----------------------------------------------------------------------------
# Optional: Rate Limiting
# ----------------------------------------------------------------------------
RATE_LIMIT_AUTH=10
RATE_LIMIT_API=100
RATE_LIMIT_WINDOW=60

# ----------------------------------------------------------------------------
# Optional: Session Configuration
# ----------------------------------------------------------------------------
SESSION_TTL=604800
SESSION_REFRESH_THRESHOLD=86400

# ----------------------------------------------------------------------------
# Optional: Advanced Settings
# ----------------------------------------------------------------------------
# PostgreSQL Connection Pool
DB_POOL_MIN=5
DB_POOL_MAX=20

# Redis Connection Pool
REDIS_POOL_MIN=5
REDIS_POOL_MAX=20

# Cache TTL (seconds)
CACHE_TTL=3600

# ----------------------------------------------------------------------------
# Development Tools
# ----------------------------------------------------------------------------
# Enable Drizzle Studio
ENABLE_DRIZZLE_STUDIO=true

# Enable Redis Commander
ENABLE_REDIS_COMMANDER=true

# Enable Mailpit (email testing)
ENABLE_MAILPIT=true
