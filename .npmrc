# Network resilience for CI / Docker installs.
#
# npm and pnpm both read these settings. Defaults hang indefinitely on a
# stalled connection, which is what causes the "install deps stuck" symptom
# when several parallel Docker builds hit the registry at once. These make
# fetches fail fast and retry on transient errors instead of hanging.

# Number of times to retry a failed request (applies to fetch too).
fetch-retries=5

# Backoff factor between retries.
fetch-retry-factor=2

# Min/max delay between retries (ms).
fetch-retry-mintimeout=1000
fetch-retry-maxtimeout=60000

# Time to wait for a response before considering the request stalled (ms).
fetch-timeout=120000

# Connection timeout (ms).
# fetch-connect-timeout=30000

# Limit concurrent network sockets — 5 parallel Docker builds each fetching the
# same registry can otherwise overwhelm a single connection and trigger stalls.
# network-concurrency=16
