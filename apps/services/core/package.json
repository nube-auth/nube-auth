{
	"name": "@nube-auth/core",
	"version": "1.0.0",
	"description": "Authoritative identity, session, and licensing service for Nube Auth",
	"type": "module",
	"main": "dist/index.js",
	"files": [
		"dist"
	],
	"exports": {
		".": "./dist/index.js",
		"./utils/*": "./dist/utils/*.js"
	},
	"scripts": {
		"dev": "dotenv -e ../../../.env.local -- tsx watch src/index.ts",
		"build": "tsup",
		"start": "node dist/index.js",
		"typecheck": "tsc --noEmit",
		"test": "vitest run"
	},
	"dependencies": {
		"@hono/node-server": "^1.19.17",
		"@nube-auth/auth": "workspace:*",
		"@nube-auth/billing": "workspace:*",
		"@nube-auth/cache": "workspace:*",
		"@nube-auth/db": "workspace:*",
		"@nube-auth/queue": "workspace:*",
		"@nube-auth/shared": "workspace:*",
		"bullmq": "^6.5.4",
		"hono": "4.13.13",
		"ioredis": "^6.0.0"
	},
	"devDependencies": {
		"@hono/zod-validator": "^0.7.6",
		"@types/node": "^25.0.3",
		"tsup": "^8.0.0",
		"tsx": "^4.23.15",
		"typescript": "^6.0.2",
		"vitest": "^3.2.7",
		"zod": "^4.6.7"
	}
}
