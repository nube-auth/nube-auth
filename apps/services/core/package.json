{
	"name": "@proofa/core",
	"version": "1.0.0",
	"description": "Authoritative identity, session, and licensing service for Proofa",
	"type": "module",
	"main": "dist/index.js",
	"exports": {
		".": "./dist/index.js"
	},
	"scripts": {
		"dev": "dotenv -e ../../../.env.local -- tsx watch src/index.ts",
		"build": "tsup src/index.ts --format esm --target node22 --clean",
		"typecheck": "tsc --noEmit",
		"test": "vitest"
	},
	"dependencies": {
		"@hono/node-server": "^1.19.7",
		"@proofa/auth": "workspace:*",
		"@proofa/cache": "workspace:*",
		"@proofa/db": "workspace:*",
		"@proofa/queue": "workspace:*",
		"@proofa/shared": "workspace:*",
		"bullmq": "^5.8.0",
		"dodopayments": "^2.21.0",
		"hono": "^4.0.0",
		"ioredis": "^5.3.2",
		"resend": "^2.0.0",
		"stripe": "^17.3.0"
	},
	"devDependencies": {
		"@hono/zod-validator": "^0.7.6",
		"@types/node": "^20.10.0",
		"tsup": "^8.0.0",
		"tsx": "^4.7.0",
		"typescript": "^5.3.0",
		"vitest": "^1.0.0",
		"zod": "^4.2.1"
	}
}
