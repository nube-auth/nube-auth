# Environment Variables for @proofa/core

## Core Public URL (for OAuth callbacks)
CORE_PUBLIC_URL=http://localhost:3003

## Database
DATABASE_URL=postgresql://user:password@localhost:5432/proofa_core
DATABASE_AUTH_TOKEN=

## OAuth Providers
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

## Security
JWT_SECRET=your-jwt-secret-key-min-32-chars
SESSION_SECRET=your-session-secret-key-min-32-chars
S2S_SECRET=your-server-to-server-secret-key

## Redis
REDIS_URL=redis://localhost:6379

## Application
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
