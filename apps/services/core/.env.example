# Environment Variables for @proofa/core

## Database
DATABASE_URL=postgresql://user:password@localhost:5432/proofa_core

## OAuth Providers
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

## Security
JWT_SECRET=your-jwt-secret-key-min-32-chars
SESSION_SECRET=your-session-secret-key-min-32-chars
S2S_SECRET=your-server-to-server-secret-key

## Redis
REDIS_URL=redis://localhost:6379

## Application
NODE_ENV=development
CORE_PORT=3003
LOG_LEVEL=info

## Service URLs
# Public URL of core service (used for webhook URLs, OAuth callbacks)
CORE_PUBLIC_URL=http://localhost:3003
API_BASE_URL=http://localhost:3003
ADMIN_DASHBOARD_URL=http://localhost:5174
# Comma-separated allowed OAuth redirect origins
ALLOWED_REDIRECT_ORIGINS=http://localhost:3004,http://localhost:5173,http://localhost:5174

## Email
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@localhost
SEND_EMAILS=false

## Payment configs encryption key (32 bytes hex)
PAYMENT_CONFIGS_KEY=00000000000000000000000000000000
