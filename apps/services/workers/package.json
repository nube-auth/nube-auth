{
	"name": "@nube-auth/workers",
	"version": "1.0.0",
	"description": "Background job workers service for Nube Auth",
	"type": "module",
	"main": "dist/index.js",
	"exports": {
		".": "./dist/index.js"
	},
	"scripts": {
		"dev": "dotenv -e ../../../.env.local -- tsx watch src/index.ts",
		"build": "tsup",
		"start": "node dist/index.js",
		"typecheck": "tsc --noEmit",
		"test": "vitest"
	},
	"dependencies": {
		"@nube-auth/db": "workspace:*",
		"@nube-auth/queue": "workspace:*",
		"@nube-auth/shared": "workspace:*",
		"bullmq": "^5.8.0",
		"ioredis": "^5.3.2"
	},
	"devDependencies": {
		"@types/node": "^20.10.0",
		"dotenv-cli": "^7.4.2",
		"tsup": "^8.0.0",
		"tsx": "^4.7.0",
		"typescript": "^6.0.2",
		"vitest": "^1.0.0"
	}
}
