{
	"name": "@nube-auth/workers",
	"version": "1.0.0",
	"description": "Background job workers service for Nube Auth",
	"type": "module",
	"main": "dist/index.js",
	"exports": {
		".": "./dist/index.js"
	},
	"scripts": {
		"dev": "dotenv -e ../../../.env.local -- tsx watch src/index.ts",
		"build": "tsdown",
		"start": "node dist/index.js",
		"typecheck": "tsc --noEmit",
		"test": "vitest run --passWithNoTests"
	},
	"dependencies": {
		"@nube-auth/billing": "workspace:*",
		"@nube-auth/cache": "workspace:*",
		"@nube-auth/db": "workspace:*",
		"@nube-auth/queue": "workspace:*",
		"@nube-auth/shared": "workspace:*",
		"bullmq": "^6.5.4",
		"ioredis": "^6.0.0"
	},
	"devDependencies": {
		"@types/node": "^25.0.3",
		"dotenv-cli": "^11.1.0",
		"tsdown": "^0.23.4",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"vitest": "^3.2.7"
	}
}
