{
	"name": "@nube-auth/gateway",
	"version": "1.0.0",
	"description": "Backend-for-Frontend gateway service for Nube Auth",
	"type": "module",
	"main": "dist/index.js",
	"scripts": {
		"dev": "dotenv -e ../../../.env.local -- tsx watch src/index.ts",
		"build": "tsdown",
		"start": "node dist/index.js",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@hono/node-server": "^1.19.17",
		"@nube-auth/auth": "workspace:*",
		"@nube-auth/cache": "workspace:*",
		"@nube-auth/shared": "workspace:*",
		"@stripe/stripe-js": "^5.5.0",
		"hono": "4.13.13",
		"nanoid": "^5.1.16",
		"stripe": "^17.6.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@types/node": "^25.0.3",
		"tsdown": "^0.23.4",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2"
	},
	"engines": {
		"node": ">=24.0.0"
	}
}
