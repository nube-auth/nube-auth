{
	"name": "@proofa/gateway",
	"version": "1.0.0",
	"description": "Backend-for-Frontend gateway service for Proofa",
	"type": "module",
	"main": "dist/index.js",
	"scripts": {
		"dev": "dotenv -e ../../../.env.local -- tsx watch src/index.ts",
		"build": "tsup src/index.ts --format esm --target node22 --clean",
		"typecheck": "tsc --noEmit",
		"preview": "node dist/index.js"
	},
	"dependencies": {
		"@hono/node-server": "^1.19.7",
		"@proofa/auth": "workspace:*",
		"@proofa/cache": "workspace:*",
		"@proofa/db": "workspace:*",
		"@proofa/shared": "workspace:*",
		"@stripe/stripe-js": "^5.5.0",
		"hono": "^4.0.0",
		"nanoid": "^5.0.0",
		"pingpong-fetch": "^1.3.0",
		"resend": "^3.2.0",
		"stripe": "^17.6.0",
		"zod": "^3.22.4"
	},
	"devDependencies": {
		"@types/node": "^20.10.0",
		"tsup": "^8.0.0",
		"tsx": "^4.7.0",
		"typescript": "^5.3.3"
	},
	"engines": {
		"node": ">=18.0.0"
	}
}
