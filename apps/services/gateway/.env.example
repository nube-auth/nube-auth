# Environment
NODE_ENV=development
GATEWAY_PORT=3004
GATEWAY_PUBLIC_URL=http://localhost:3004
USER_DASHBOARD_URL=http://localhost:5173
ADMIN_DASHBOARD_URL=http://localhost:5174
FRONTEND_URL=http://localhost:5173
# Leave empty for host-only cookies (no Domain attribute). Set to ".yourdomain.com" for subdomain sharing.
COOKIE_DOMAIN=
# Namespace cookie names so multiple environments can share one parent domain safely.
# Examples: production="", staging="s", local="local"
COOKIE_NAMESPACE=

# Core service (shared secret must match Core's S2S_SECRET)
CORE_URL=http://localhost:3003
S2S_SECRET=dev-s2s-secret
X_NUBE_AUTH_SERVICE_TOKEN=dev-service-token

# Gateway session signing
SESSION_SECRET=dev-gateway-session-secret

# Database & cache
DATABASE_URL=postgres://user:password@localhost:5432/proofa
REDIS_URL=redis://localhost:6379

# Email
EMAIL_API_KEY=your-resend-api-key
EMAIL_FROM=noreply@proofa.local
SEND_EMAILS=false

# Encryption (32 bytes key for credentials)
ENCRYPTION_KEY=00000000000000000000000000000000

# Stripe (optional in dev)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
