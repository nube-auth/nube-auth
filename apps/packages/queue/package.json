{
  "name": "@proofa/queue",
  "version": "0.1.0",
  "description": "BullMQ queue management for Proofa (with future RabbitMQ support)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./client": {
      "import": "./dist/client.js",
      "types": "./dist/client.d.ts"
    },
    "./types": {
      "import": "./dist/types.js",
      "types": "./dist/types.d.ts"
    },
    "./jobs": {
      "import": "./dist/jobs/index.js",
      "types": "./dist/jobs/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "bullmq": "^5.8.0",
    "ioredis": "^5.8.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0"
  },
  "keywords": [
    "queue",
    "job",
    "bullmq",
    "redis",
    "worker",
    "background-jobs"
  ],
  "author": "Proofa",
  "license": "MIT"
}
