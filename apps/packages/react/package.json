{
	"name": "@nube-auth/react",
	"version": "0.1.6",
	"description": "React hooks and components for Nube Auth authentication and user management",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		}
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"clean": "rm -rf dist",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@nube-auth/client": "workspace:*",
		"@tanstack/react-query": "^5.62.11"
	},
	"devDependencies": {
		"@types/react": "^18.3.18",
		"react": "^18.3.1",
		"tsup": "^8.0.0",
		"typescript": "^6.0.2"
	},
	"peerDependencies": {
		"react": ">=18.0.0"
	},
	"keywords": [
		"auth",
		"authentication",
		"nube-auth",
		"react",
		"hooks"
	],
	"author": "Nube Auth",
	"license": "MIT",
	"publishConfig": {
		"access": "public"
	}
}
