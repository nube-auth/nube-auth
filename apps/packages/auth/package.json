{
  "name": "@proofa/auth",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "OAuth adapter framework for Proofa",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./pingpong": {
      "import": "./dist/pingpong.js",
      "types": "./dist/pingpong.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "@pingpong-js/fetch": "^1.0.2",
    "@proofa/shared": "workspace:*",
    "jose": "^6.1.3",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "typescript": "^5.3.3"
  },
  "optionalDependencies": {
    "google-auth-library": "^9.4.1",
    "octokit": "^3.1.0"
  },
  "files": [
    "dist"
  ]
}
