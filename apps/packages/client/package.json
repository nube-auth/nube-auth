{
	"name": "@nube-auth/client",
	"version": "0.3.3",
	"description": "Nube Auth API client for TypeScript/JavaScript applications",
	"type": "module",
	"main": "./dist/index.cjs",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		}
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"clean": "rm -rf dist",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@pingpong-js/fetch": "^1.0.1"
	},
	"devDependencies": {
		"tsdown": "^0.23.4",
		"typescript": "^7.0.2"
	},
	"keywords": [
		"auth",
		"authentication",
		"nube-auth",
		"sdk",
		"client"
	],
	"author": "Nube Auth",
	"license": "MIT",
	"publishConfig": {
		"access": "public"
	}
}
