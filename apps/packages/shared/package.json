{
	"name": "@nube-auth/shared",
	"version": "1.0.0",
	"type": "module",
	"private": true,
	"description": "Shared types, utilities, and constants for Nube Auth",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		},
		"./types/schemas": {
			"import": "./dist/types/schemas/index.js",
			"types": "./dist/types/schemas/index.d.ts"
		},
		"./env-loader": {
			"import": "./dist/env-loader.js",
			"types": "./dist/env-loader.d.ts"
		},
		"./email": {
			"import": "./dist/email.js",
			"types": "./dist/email.d.ts"
		},
		"./outbound-url": {
			"import": "./dist/outbound-url.js",
			"types": "./dist/outbound-url.d.ts"
		}
	},
	"scripts": {
		"build": "tsdown",
		"typecheck": "tsc --noEmit",
		"dev": "tsdown --watch"
	},
	"dependencies": {
		"@pingpong-js/fetch": "^1.0.2",
		"hono": "4.13.13",
		"pino": "^10.4.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"nanoid": "^5.1.16",
		"tsdown": "^0.23.4",
		"typescript": "^7.0.2"
	},
	"files": [
		"dist"
	]
}
