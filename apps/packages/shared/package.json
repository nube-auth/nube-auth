{
	"name": "@proofa/shared",
	"version": "1.0.0",
	"type": "module",
	"private": true,
	"description": "Shared types, utilities, and constants for Proofa",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		},
		"./types/schemas": {
			"import": "./dist/types/schemas/index.js",
			"types": "./dist/types/schemas/index.d.ts"
		},
		"./env-loader": {
			"import": "./dist/env-loader.js",
			"types": "./dist/env-loader.d.ts"
		},
		"./email": {
			"import": "./dist/email.js",
			"types": "./dist/email.d.ts"
		}
	},
	"scripts": {
		"build": "tsc",
		"typecheck": "tsc --noEmit",
		"dev": "tsc --watch"
	},
	"dependencies": {
		"@proofa/cache": "workspace:*",
		"hono": "^4.6.14",
		"nodemailer": "^7.0.12",
		"pino": "^10.1.0",
		"resend": "^3.2.0",
		"zod": "^3.22.4"
	},
	"devDependencies": {
		"@types/nodemailer": "^7.0.4",
		"typescript": "^5.3.3",
		"nanoid": "^4.0.2"
	}
}
