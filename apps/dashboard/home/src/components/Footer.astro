---
import config from "../config";
---

<footer class="footer">
  <div class="page-width">
    <div class="footer-grid">
      <div class="footer-brand">
        <a href="/" class="brand">
          <img src="/favicon.png" alt="" width="28" height="28" />
          <span>NubeAuth</span>
        </a>
        <p class="footer-tagline">Sign-in, sessions, and licensing for the apps you ship.</p>
      </div>

      <div>
        <h2 class="footer-heading">Product</h2>
        <ul class="footer-links">
          <li><a href={config.adminLoginUrl}>Admin console</a></li>
          <li><a href={config.userLoginUrl}>User portal</a></li>
          <li><a href="/pricing">Pricing</a></li>
        </ul>
      </div>

      <div>
        <h2 class="footer-heading">Developers</h2>
        <ul class="footer-links">
          <li><a href={config.docsUrl}>Documentation</a></li>
          <li><a href={`${config.docsUrl}/integration/quickstart`}>Quick start</a></li>
          <li><a href={`${config.docsUrl}/api/rest`}>API reference</a></li>
          <li><a href={`${config.docsUrl}/integration/browser-extension`}>Browser extensions</a></li>
        </ul>
      </div>

      <div>
        <h2 class="footer-heading">Help</h2>
        <ul class="footer-links">
          <li><a href="/support">Support</a></li>
          <li><a href="https://github.com/nube-auth/nube-auth" rel="noopener">GitHub</a></li>
          <li><a href="/privacy">Privacy policy</a></li>
          <li><a href="/terms">Terms of service</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <span>© 2026 NubeAuth</span>
      <span class="mono">{config.envTag}</span>
    </div>
  </div>
</footer>
