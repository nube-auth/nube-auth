---
import config from "../config";
---

<nav class="nav" aria-label="Main">
  <div class="page-width nav-inner">
    <a href="/" class="brand">
      <img src="/favicon-32x32.png" alt="" width="26" height="26" />
      <span>NubeAuth</span>
      <span class="env-tag">{config.envTag}</span>
    </a>

    <div class="nav-links">
      <a href="/#surfaces" class="nav-link">Product</a>
      <a href="/#integrate" class="nav-link">How it works</a>
      <a href="/pricing" class="nav-link">Pricing</a>
      <a href={config.docsUrl} class="nav-link">Docs</a>
    </div>

    <div class="nav-actions">
      <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Change color theme" title="System">
        <svg class="sun-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"/>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/>
        </svg>
        <svg class="moon-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
        <svg class="system-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="2" y="3" width="20" height="14" rx="2"/>
          <path d="M8 21h8M12 17v4"/>
        </svg>
        <span class="theme-label sr-only">System</span>
      </button>
      <a href={config.adminLoginUrl} class="nav-signin">Sign in</a>
      <a href={config.adminLoginUrl} class="btn btn-primary btn-sm">Get started</a>
    </div>
  </div>
</nav>
