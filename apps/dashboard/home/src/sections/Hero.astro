---
import Nav from '../components/Nav.astro';
---

<Nav />

<section class="hero">
  <div class="hero-container">
    <div class="hero-badge animate-fade-in">
      <span class="hero-badge-dot"></span>
      <span>Beta</span>
    </div>
    
    <h1 class="hero-title animate-fade-in animate-delay-100">
      Authentication & Licensing
      <br />
      <span class="hero-title-highlight">Made Simple</span>
    </h1>
    
    <p class="hero-description animate-fade-in animate-delay-200">
      Drop-in authentication, session management, and licensing for your SaaS applications.
      OAuth providers, multi-tenant projects, and flexible licensing in minutes.
    </p>
    
    <div class="hero-actions animate-fade-in animate-delay-300">
      <a href="/signup" class="btn btn-primary btn-lg">
        Get Started Free
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"/>
          <polyline points="12 5 19 12 12 19"/>
        </svg>
      </a>
      <a href="#how-it-works" class="btn btn-outline btn-lg">
        See How It Works
      </a>
    </div>
    
    <div class="hero-stats animate-fade-in animate-delay-400">
      <div class="hero-stat">
        <svg class="hero-stat-icon" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
        </svg>
        <span>OAuth Providers</span>
      </div>
      <div class="hero-stat">
        <svg class="hero-stat-icon" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
        </svg>
        <span>Multi-Tenant</span>
      </div>
      <div class="hero-stat">
        <svg class="hero-stat-icon" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
        </svg>
        <span>Flexible Licensing</span>
      </div>
    </div>
  </div>
</section>
