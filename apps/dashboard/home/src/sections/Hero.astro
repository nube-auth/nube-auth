---
import config from '../config';

const gatewayHost = new URL(config.gatewayUrl).host;
---

<section class="hero">
  <div class="page-width hero-grid">
    <div>
      <p class="eyebrow">Auth gateway for SaaS apps</p>
      <h1 class="hero-title">Sign-in, sessions, and licenses. <em>One gateway.</em></h1>
      <p class="hero-lede">
        NubeAuth runs the OAuth handshake with PKCE, hands your app a session token, and tells
        it which plan each user is on. You set it up in the admin console and call it from your code.
      </p>
      <div class="hero-actions">
        <a href={config.adminLoginUrl} class="btn btn-primary btn-lg">Open the admin console</a>
        <a href={`${config.docsUrl}/integration/quickstart`} class="btn btn-outline btn-lg">Read the quick start</a>
      </div>
      <p class="hero-note">Free during beta. Sign in with Google.</p>
    </div>

    <figure class="trace" aria-label="The requests behind one NubeAuth sign-in">
      <figcaption class="trace-head">
        <span class="trace-title">One sign-in, start to finish</span>
        <span class="trace-host">{gatewayHost}</span>
      </figcaption>
      <ol class="trace-rows">
        <li class="trace-row">
          <span class="trace-method">GET</span>
          <span class="trace-path">/v1/auth/start?app_id=APP0x7k2&amp;code_challenge=…
            <span class="trace-detail">PKCE S256. Redirects the browser to Google.</span>
          </span>
          <span class="trace-status hold">302</span>
        </li>
        <li class="trace-row">
          <span class="trace-method">GET</span>
          <span class="trace-path">accounts.google.com/o/oauth2/auth
            <span class="trace-detail">The user picks an account.</span>
          </span>
          <span class="trace-status hold">302</span>
        </li>
        <li class="trace-row">
          <span class="trace-method">GET</span>
          <span class="trace-path">/v1/auth/callback/google?code=4/0Ad…
            <span class="trace-detail trace-cookie">Location: https://yourapp.com/auth?code=… (one use, 60 s)</span>
          </span>
          <span class="trace-status hold">302</span>
        </li>
        <li class="trace-row">
          <span class="trace-method">POST</span>
          <span class="trace-path">/v1/auth/token
            <span class="trace-detail">{'{ "sessionToken": "…", "userId": "USR0q41m" }'}</span>
          </span>
          <span class="trace-status granted">200</span>
        </li>
        <li class="trace-row">
          <span class="trace-method">GET</span>
          <span class="trace-path">/v1/license/APP0x7k2
            <span class="trace-detail">{'{ "plan": "pro", "status": "active" }'}</span>
          </span>
          <span class="trace-status granted">200</span>
        </li>
      </ol>
      <p class="trace-foot">The one-time code is worthless without the verifier your app kept.</p>
    </figure>
  </div>
</section>
