---
const rows = [
  {
    term: 'Sign-in',
    detail: 'Google and GitHub OAuth with PKCE. Configure providers once per project or override them per app.',
  },
  {
    term: 'Sessions',
    detail: 'Bearer tokens for your apps, HttpOnly cookies with CSRF checks for the dashboards. Requests are rate limited, and users can revoke any session from the portal.',
  },
  {
    term: 'Licensing',
    detail: 'Plans with trials and monthly, yearly, or lifetime billing. Your app asks <code>GET /v1/license/:appId</code> and gets the plan back.',
  },
  {
    term: 'Payments',
    detail: 'Stripe, LemonSqueezy, and Dodo. Provider credentials are stored encrypted, and every webhook is logged and deduplicated.',
  },
  {
    term: 'Team',
    detail: 'Invite teammates to a project as owner, admin, or member. Each role sees only what it is allowed to change.',
  },
];
---

<section id="features" class="section">
  <div class="page-width spec">
    <div class="section-head">
      <p class="eyebrow">What the gateway handles</p>
      <h2 class="section-title">The auth work you would otherwise maintain.</h2>
      <p class="section-lede">Everything below runs behind the gateway. Your app makes a few requests and reads the answers.</p>
    </div>

    <dl class="spec-list">
      {rows.map((row) => (
        <div class="spec-row">
          <dt>{row.term}</dt>
          <dd set:html={row.detail} />
        </div>
      ))}
    </dl>
  </div>
</section>
