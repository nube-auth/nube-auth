---
import config from '../config';
---

<section class="closing">
  <div class="page-width">
    <div class="closing-panel">
      <div>
        <h2 class="closing-title">Create your first project.</h2>
        <p class="closing-lede">It takes a Google account and about five minutes.</p>
      </div>
      <div class="closing-actions">
        <a href={config.adminLoginUrl} class="btn btn-primary btn-lg">Open the admin console</a>
        <a href={config.docsUrl} class="btn btn-outline btn-lg">Read the docs</a>
      </div>
    </div>
  </div>
</section>
