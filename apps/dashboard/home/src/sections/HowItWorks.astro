---
const steps = [
  {
    number: 1,
    title: 'Create a Project',
    description: 'Sign up and create your first project in the admin dashboard.'
  },
  {
    number: 2,
    title: 'Add Your App',
    description: 'Configure OAuth providers, redirect URIs, and licensing options.'
  },
  {
    number: 3,
    title: 'Integrate',
    description: 'Add authentication to your app with our simple SDK and APIs.'
  }
];

const codeExample = `import { ProofaClient } from '@proofa/sdk';

const proofa = new ProofaClient({
  appId: 'your-app-id',
  apiUrl: 'https://api.proofa.com'
});

// Redirect to login
await proofa.login({ provider: 'google' });

// Get current user
const user = await proofa.getUser();`;
---

<section id="how-it-works" class="how-it-works">
  <div class="how-it-works-container">
    <div class="section-header">
      <span class="section-tag">Quick Start</span>
      <h2 class="section-title">How It Works</h2>
      <p class="section-description">
        Get started in minutes, not hours
      </p>
    </div>

    <div class="steps-grid">
      {steps.map((step) => (
        <div class="step">
          <div class="step-number">{step.number}</div>
          <h3 class="step-title">{step.title}</h3>
          <p class="step-description">{step.description}</p>
        </div>
      ))}
    </div>

    <div class="code-block">
      <div class="code-block-header">
        <div class="code-block-dots">
          <span class="code-block-dot red"></span>
          <span class="code-block-dot yellow"></span>
          <span class="code-block-dot green"></span>
        </div>
        <span class="code-block-tab">app.ts</span>
      </div>
      <div class="code-block-body">
        <pre><code><span class="code-comment"># Install the SDK</span>
<span class="code-variable">npm install</span> <span class="code-string">@proofa/sdk</span>

<span class="code-comment"># Initialize in your app</span>
<span class="code-keyword">import</span> {'{'} <span class="code-property">ProofaClient</span> {'}'} <span class="code-keyword">from</span> <span class="code-string">'@proofa/sdk'</span>;

<span class="code-keyword">const</span> <span class="code-variable">proofa</span> = <span class="code-keyword">new</span> <span class="code-function">ProofaClient</span>({'{'}
  <span class="code-property">appId</span>: <span class="code-string">'your-app-id'</span>,
  <span class="code-property">apiUrl</span>: <span class="code-string">'https://api.proofa.com'</span>
{'}'});

<span class="code-comment">// Redirect to login</span>
<span class="code-keyword">await</span> <span class="code-variable">proofa</span>.<span class="code-function">login</span>({'{'} <span class="code-property">provider</span>: <span class="code-string">'google'</span> {'}'});

<span class="code-comment">// Get current user</span>
<span class="code-keyword">const</span> <span class="code-variable">user</span> = <span class="code-keyword">await</span> <span class="code-variable">proofa</span>.<span class="code-function">getUser</span>();</code></pre>
      </div>
    </div>
  </div>
</section>
