---
import config from '../config';
---

<section id="integrate" class="section">
  <div class="page-width integrate">
    <div>
      <div class="section-head">
        <p class="eyebrow">How it works</p>
        <h2 class="section-title">From empty project to signed-in user.</h2>
      </div>

      <ol class="steps">
        <li class="step">
          <div>
            <h3 class="step-title">Create a project</h3>
            <p class="step-body">Sign in to the <a href={config.adminLoginUrl}>admin console</a> and create a project. Invite your team and connect a payment provider if you charge.</p>
          </div>
        </li>
        <li class="step">
          <div>
            <h3 class="step-title">Add your app</h3>
            <p class="step-body">Register the app, turn on Google or GitHub, list your redirect URLs, and define the plans users can hold.</p>
          </div>
        </li>
        <li class="step">
          <div>
            <h3 class="step-title">Call the gateway</h3>
            <p class="step-body">Start sign-in, swap the returned code for a session token, then check the license. The <a href={`${config.docsUrl}/integration/quickstart`}>quick start</a> covers React, plain JavaScript, and extensions.</p>
          </div>
        </li>
      </ol>
    </div>

    <div class="code">
      <div class="code-head">auth.ts</div>
      <pre><code><span class="code-keyword">import</span> {'{'} NubeAuthClient {'}'} <span class="code-keyword">from</span> <span class="code-string">'@nube-auth/client'</span>;

<span class="code-keyword">const</span> gatewayUrl = <span class="code-string">'{config.gatewayUrl}'</span>;
<span class="code-keyword">const</span> appId = <span class="code-string">'APP0x7k2'</span>;
<span class="code-keyword">const</span> nube = <span class="code-keyword">new</span> NubeAuthClient({'{'} gatewayUrl, appId {'}'});

<span class="code-comment">// 1. Send the user to sign in</span>
<span class="code-keyword">const</span> {'{'} url, codeVerifier {'}'} = <span class="code-keyword">await</span> nube.app.buildOAuthUrl({'{'}
  returnTo: <span class="code-string">'https://yourapp.com/auth'</span>,
{'}'});
sessionStorage.setItem(<span class="code-string">'pkce'</span>, codeVerifier);
location.assign(url);

<span class="code-comment">// 2. Back on /auth?code=…, swap the code for a token</span>
<span class="code-keyword">const</span> {'{'} sessionToken {'}'} = <span class="code-keyword">await</span> nube.app.exchangeCode(code, {'{'}
  codeVerifier: sessionStorage.getItem(<span class="code-string">'pkce'</span>),
{'}'});

<span class="code-comment">// 3. Ask which plan they are on</span>
<span class="code-keyword">const</span> user = <span class="code-keyword">new</span> NubeAuthClient({'{'} gatewayUrl, appId, sessionToken {'}'});
<span class="code-keyword">const</span> {'{'} plan, status {'}'} = <span class="code-keyword">await</span> user.license.getDetails();</code></pre>
    </div>
  </div>
</section>
