---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import config from '../config';
---

<Layout title="Support - NubeAuth" description="Get help with NubeAuth from the docs, email, or GitHub.">
  <Nav />
  <div class="legal-page">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 pt-28 pb-16">
      <div class="mb-8">
        <a href="/" class="legal-back transition inline-flex items-center gap-2">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
          </svg>
          Back to Home
        </a>
      </div>

      <h1 class="text-2xl sm:text-4xl font-bold mb-4">Support</h1>
      <p class="mb-8">Choose the path that matches what you need to do.</p>

      <ul class="space-y-4">
        <li class="rounded-xl border p-6" style="background: var(--card-bg); border-color: var(--card-border);">
          <h2 class="text-xl font-bold mb-2">Documentation</h2>
          <p class="mb-4">Integration guides, dashboard walkthroughs, and the API reference.</p>
          <a href={config.docsUrl} class="btn btn-primary" target="_blank" rel="noopener">Open docs</a>
        </li>
        <li class="rounded-xl border p-6" style="background: var(--card-bg); border-color: var(--card-border);">
          <h2 class="text-xl font-bold mb-2">Email</h2>
          <p class="mb-4">Account and product questions go to the support inbox.</p>
          <a href="mailto:support@nubeauth.com" class="btn btn-outline">support@nubeauth.com</a>
        </li>
        <li class="rounded-xl border p-6" style="background: var(--card-bg); border-color: var(--card-border);">
          <h2 class="text-xl font-bold mb-2">GitHub</h2>
          <p class="mb-4">Report a bug or follow an implementation issue in the repository.</p>
          <a href="https://github.com/nube-auth/nube-auth/issues" class="btn btn-outline" target="_blank" rel="noopener">Open an issue</a>
        </li>
      </ul>
    </div>
  </div>
  <Footer />
</Layout>
