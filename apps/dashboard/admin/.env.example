# Proofa Admin Dashboard - Environment Variables

# Gateway API URL
# The backend API gateway that handles all admin operations
VITE_GATEWAY_URL=http://localhost:3004

# Core API URL  
# The core authentication and user management service
VITE_CORE_URL=http://localhost:3003

# Marketing Website URL
# Link to the main Proofa homepage
VITE_HOME_URL=http://localhost:4321

# Documentation Website URL
# Link to Proofa documentation
VITE_DOCS_URL=http://localhost:4322

# Cookie namespace must match the gateway's COOKIE_NAMESPACE.
# Examples: production="", staging="s", local="local"
VITE_COOKIE_NAMESPACE=

# Production URLs (for reference - set in Vercel/hosting)
# VITE_GATEWAY_URL=https://api.proofa.sh
# VITE_CORE_URL=https://core.proofa.sh
# VITE_HOME_URL=https://proofa.sh
# VITE_DOCS_URL=https://docs.proofa.sh
