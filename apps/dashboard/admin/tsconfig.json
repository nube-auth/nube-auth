{
	"compilerOptions": {
		"target": "ES2020",
		"lib": ["ES2020", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"skipLibCheck": true,

		/* Bundler mode */
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"noEmit": true,
		"jsx": "react-jsx",
		"types": ["vite/client"],
		"paths": {
			// Utilities
			"@/lib": ["./src/lib"],
			"@/lib/*": ["./src/lib/*"],
			// Nube Auth packages
			"@nube-auth/auth": ["../../packages/auth/src"],
			"@nube-auth/auth/*": ["../../packages/auth/src/*"],
			"@nube-auth/cache": ["../../packages/cache/src"],
			"@nube-auth/cache/*": ["../../packages/cache/src/*"],
			"@nube-auth/client": ["../../packages/client/src"],
			"@nube-auth/client/*": ["../../packages/client/src/*"],
			"@nube-auth/db": ["../../packages/db/src"],
			"@nube-auth/db/*": ["../../packages/db/src/*"],
			"@nube-auth/queue": ["../../packages/queue/src"],
			"@nube-auth/queue/*": ["../../packages/queue/src/*"],
			"@nube-auth/react": ["../../packages/react/src"],
			"@nube-auth/react/*": ["../../packages/react/src/*"],
			"@nube-auth/shared": ["../../packages/shared/src"],
			"@nube-auth/shared/*": ["../../packages/shared/src/*"]
		},

		/* Strict mode */
		"strict": true,

		/* Additional recommended checks */
		"noImplicitReturns": true,
		"noFallthroughCasesInSwitch": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,
		"forceConsistentCasingInFileNames": true
	},
	"include": ["src"],
	"references": [{ "path": "./tsconfig.node.json" }]
}
