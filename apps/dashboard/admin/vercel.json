{
	"buildCommand": "cd ../../../ && pnpm build --filter=@proofa/dashboard-admin",
	"devCommand": "pnpm dev",
	"installCommand": "cd ../../../ && pnpm install",
	"framework": "vite",
	"outputDirectory": "dist",
	"rewrites": [
		{
			"source": "/api/:path*",
			"destination": "https://api.proofa.sh/v1/:path*"
		},
		{
			"source": "/((?!assets/).*)",
			"destination": "/index.html"
		}
	]
}
