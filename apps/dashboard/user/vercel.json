{
	"buildCommand": "pnpm build",
	"devCommand": "pnpm dev",
	"installCommand": "pnpm install",
	"framework": "vite",
	"outputDirectory": "dist",
	"rewrites": [
		{
			"source": "/api/:path*",
			"destination": "https://gateway.proofa.dev/v1/:path*"
		},
		{
			"source": "/((?!assets/).*)",
			"destination": "/index.html"
		}
	]
}
