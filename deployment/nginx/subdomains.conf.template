# ─────────────────────────────────────────────────────────────────────────────
# Nube Auth – Subdomain-based routing
#
# Resolved at container startup via envsubst. Set DOMAIN to the base domain and
# SUBDOMAIN_PREFIX to "" for production or "s-" for staging in Railway.
#
# PRODUCTION  (DOMAIN=nubeauth.com, SUBDOMAIN_PREFIX="")
#   manage/me/docs/home/www.nubeauth.com → Vercel (DNS never reaches Railway)
#   api/core/work.nubeauth.com           → Railway proxies
#
# STAGING     (DOMAIN=nubeauth.com, SUBDOMAIN_PREFIX="s-")
#   s-home / s-www.nubeauth.com → serve /var/www/home
#   s-manage.nubeauth.com       → serve /var/www/admin  (React SPA)
#   s-me.nubeauth.com           → serve /var/www/user   (React SPA)
#   s-docs.nubeauth.com         → serve /var/www/docs   (VitePress)
#   s-api.nubeauth.com          → Gateway proxy
#   s-core.nubeauth.com         → Core proxy
#   s-work.nubeauth.com         → Workers proxy
#
# Redirects (301):
#   ${DOMAIN} (bare)               → ${SUBDOMAIN_PREFIX}home.${DOMAIN}
#   ${SUBDOMAIN_PREFIX}user.${DOMAIN}  → ${SUBDOMAIN_PREFIX}me.${DOMAIN}
#   ${SUBDOMAIN_PREFIX}admin.${DOMAIN} → ${SUBDOMAIN_PREFIX}manage.${DOMAIN}
#   ${SUBDOMAIN_PREFIX}doc/documents.${DOMAIN} → ${SUBDOMAIN_PREFIX}docs.${DOMAIN}
# ─────────────────────────────────────────────────────────────────────────────

# ── Bare apex → ${SUBDOMAIN_PREFIX}home.${DOMAIN} ────────────────────────────
# Prod: nubeauth.com DNS points to Vercel — this block is dead code.
# Staging: if bare apex reaches Railway, redirect once to the flattened home host.
server {
    listen 8080;
    server_name ${DOMAIN};
    port_in_redirect off;
    return 301 https://${SUBDOMAIN_PREFIX}home.${DOMAIN}$request_uri;
}

# ── Home ──────────────────────────────────────────────────────────────────────
# Serves the Astro marketing site.
# Also catches the flattened www host.
# In prod these names usually never reach Railway (DNS → Vercel).
server {
    listen 8080;
    server_name ${SUBDOMAIN_PREFIX}home.${DOMAIN} ${SUBDOMAIN_PREFIX}www.${DOMAIN};
    root /var/www/home;

    # Never append the internal port (:8080) to any redirect URL.
    port_in_redirect off;

    # Serve Astro static pages cleanly (no trailing-slash 301).
    # Astro static adapter outputs pages as directories (privacy/index.html),
    # so we skip $uri/ to avoid nginx redirecting /privacy → /privacy/.
    location / {
        try_files $uri $uri.html $uri/index.html =404;
    }

    # Silently ignore Vercel-specific requests (web analytics, etc.)
    # that are injected by the Vercel adapter at build time but don't
    # exist when the site is served from nginx on Railway.
    location /_vercel/ {
        return 204;
    }

    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff2?|ttf|eot)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript image/svg+xml;
}

# ── Admin Dashboard (SPA) ─────────────────────────────────────────────────────
server {
    listen 8080;
    server_name ${SUBDOMAIN_PREFIX}manage.${DOMAIN};
    root /var/www/admin;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location /assets {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript;
}

# ── User Dashboard (SPA) ──────────────────────────────────────────────────────
server {
    listen 8080;
    server_name ${SUBDOMAIN_PREFIX}me.${DOMAIN};
    root /var/www/user;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location /assets {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript;
}

# ── Docs Site (VitePress) ─────────────────────────────────────────────────────
server {
    listen 8080;
    server_name ${SUBDOMAIN_PREFIX}docs.${DOMAIN};
    root /var/www/docs;

    location / {
        try_files $uri $uri/ $uri.html $uri/index.html =404;
    }

    location /assets {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript;
}

# ── Gateway API Proxy ─────────────────────────────────────────────────────────
# GATEWAY_INTERNAL_URL: Railway private network URL, e.g.
#   http://nubeauth-gateway.railway.internal:8080
# Both services must be in the same Railway environment for .railway.internal to resolve.
server {
    listen 8080;
    server_name ${SUBDOMAIN_PREFIX}api.${DOMAIN};

    # Use the system DNS resolver (detected at container startup from /etc/resolv.conf)
    # so nginx re-resolves Railway internal hostnames at runtime instead of caching
    # the IP at startup time.
    resolver ${NGINX_RESOLVER} valid=10s ipv6=off;

    location / {
        set $gateway "${GATEWAY_INTERNAL_URL}";
        proxy_pass $gateway;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }
}

# ── Core Service Proxy ───────────────────────────────────────────────────────
# CORE_INTERNAL_URL: Railway private network URL, e.g.
#   http://nubeauth-core.railway.internal:8080
server {
    listen 8080;
    server_name ${SUBDOMAIN_PREFIX}core.${DOMAIN};

    resolver ${NGINX_RESOLVER} valid=10s ipv6=off;

    location / {
        set $core "${CORE_INTERNAL_URL}";
        proxy_pass $core;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }
}

# ── Workers Service Proxy ─────────────────────────────────────────────────────
# WORKERS_INTERNAL_URL: Railway private network URL, e.g.
#   http://nubeauth-workers.railway.internal:8080
server {
    listen 8080;
    server_name ${SUBDOMAIN_PREFIX}work.${DOMAIN};

    resolver ${NGINX_RESOLVER} valid=10s ipv6=off;

    location / {
        set $workers "${WORKERS_INTERNAL_URL}";
        proxy_pass $workers;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }
}

# ── Health check (default server – matches any Host not explicitly listed) ────
# Used by Railway health checks, Docker HEALTHCHECK, and monitoring tools.
# Railway hits the service's own *.up.railway.app URL, which doesn't match any
# server_name above, so this default_server block answers those requests.
server {
    listen 8080 default_server;
    server_name _;

    location /health {
        access_log off;
        return 200 '{"status":"ok","service":"dashboards"}';
        add_header Content-Type application/json;
    }

    location / {
        return 404;
    }
}

# ── Legacy Subdomain Redirects (301 Permanent) ────────────────────────────────
server {
    listen 8080;
    server_name ${SUBDOMAIN_PREFIX}user.${DOMAIN};
    return 301 $scheme://${SUBDOMAIN_PREFIX}me.${DOMAIN}$request_uri;
}

server {
    listen 8080;
    server_name ${SUBDOMAIN_PREFIX}admin.${DOMAIN};
    return 301 $scheme://${SUBDOMAIN_PREFIX}manage.${DOMAIN}$request_uri;
}

server {
    listen 8080;
    server_name ${SUBDOMAIN_PREFIX}doc.${DOMAIN} ${SUBDOMAIN_PREFIX}documents.${DOMAIN};
    return 301 $scheme://${SUBDOMAIN_PREFIX}docs.${DOMAIN}$request_uri;
}
