# ─────────────────────────────────────────────────────────────────────────────
# Nube Auth – Subdomain-based routing
#
# Resolved at container startup via envsubst. Set DOMAIN in Railway Variables:
#   DOMAIN=nubeauth.com
#
# Routes:
#   ${DOMAIN}             → Home (Astro marketing site)
#   home.${DOMAIN}        → Home (Astro marketing site)
#   manage.${DOMAIN}      → Admin Dashboard (React SPA)
#   me.${DOMAIN}          → User Dashboard (React SPA)
#   docs.${DOMAIN}        → Docs (VitePress)
#   api.${DOMAIN}         → Gateway service (proxy)
#   core.${DOMAIN}        → Core service (proxy)
#   work.${DOMAIN}        → Workers service (proxy)
#
# Redirects (301):
#   user.${DOMAIN}        → me.${DOMAIN}
#   admin.${DOMAIN}       → manage.${DOMAIN}
#   doc.${DOMAIN}         → docs.${DOMAIN}
#   documents.${DOMAIN}   → docs.${DOMAIN}
# ─────────────────────────────────────────────────────────────────────────────

# ── Home ──────────────────────────────────────────────────────────────────────
# NOTE: nubeauth.com and www.nubeauth.com are served by Vercel.
# Railway only handles home.${DOMAIN} as a fallback/alias.
server {
    listen 8080;
    server_name home.${DOMAIN};
    root /var/www/home;

    # Serve Astro static pages cleanly (no trailing-slash 301).
    # Astro static adapter outputs pages as directories (privacy/index.html),
    # so we skip $uri/ to avoid nginx redirecting /privacy → /privacy/.
    location / {
        try_files $uri $uri.html $uri/index.html =404;
    }

    # Silently ignore Vercel-specific requests (web analytics, etc.)
    # that are injected by the Vercel adapter at build time but don't
    # exist when the site is served from nginx on Railway.
    location /_vercel/ {
        return 204;
    }

    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff2?|ttf|eot)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript image/svg+xml;
}

# ── Admin Dashboard (SPA) ─────────────────────────────────────────────────────
server {
    listen 8080;
    server_name manage.${DOMAIN};
    root /var/www/admin;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location /assets {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript;
}

# ── User Dashboard (SPA) ──────────────────────────────────────────────────────
server {
    listen 8080;
    server_name me.${DOMAIN};
    root /var/www/user;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location /assets {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript;
}

# ── Docs Site (VitePress) ─────────────────────────────────────────────────────
server {
    listen 8080;
    server_name docs.${DOMAIN};
    root /var/www/docs;

    location / {
        try_files $uri $uri/ $uri.html $uri/index.html =404;
    }

    location /assets {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript;
}

# ── Gateway API Proxy ─────────────────────────────────────────────────────────
# GATEWAY_INTERNAL_URL: Railway private network URL, e.g.
#   http://nubeauth-gateway.railway.internal:8080
# Both services must be in the same Railway environment for .railway.internal to resolve.
server {
    listen 8080;
    server_name api.${DOMAIN};

    # Use the system DNS resolver (detected at container startup from /etc/resolv.conf)
    # so nginx re-resolves Railway internal hostnames at runtime instead of caching
    # the IP at startup time.
    resolver ${NGINX_RESOLVER} valid=10s ipv6=off;

    location / {
        set $gateway "${GATEWAY_INTERNAL_URL}";
        proxy_pass $gateway;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }
}

# ── Core Service Proxy ───────────────────────────────────────────────────────
# CORE_INTERNAL_URL: Railway private network URL, e.g.
#   http://nubeauth-core.railway.internal:8080
server {
    listen 8080;
    server_name core.${DOMAIN};

    resolver ${NGINX_RESOLVER} valid=10s ipv6=off;

    location / {
        set $core "${CORE_INTERNAL_URL}";
        proxy_pass $core;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }
}

# ── Workers Service Proxy ─────────────────────────────────────────────────────
# WORKERS_INTERNAL_URL: Railway private network URL, e.g.
#   http://nubeauth-workers.railway.internal:8080
server {
    listen 8080;
    server_name work.${DOMAIN};

    resolver ${NGINX_RESOLVER} valid=10s ipv6=off;

    location / {
        set $workers "${WORKERS_INTERNAL_URL}";
        proxy_pass $workers;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }
}

# ── Health check (default server – matches any Host not explicitly listed) ────
# Used by Railway health checks, Docker HEALTHCHECK, and monitoring tools.
# Railway hits the service's own *.up.railway.app URL, which doesn't match any
# server_name above, so this default_server block answers those requests.
server {
    listen 8080 default_server;
    server_name _;

    location /health {
        access_log off;
        return 200 '{"status":"ok","service":"dashboards"}';
        add_header Content-Type application/json;
    }

    location / {
        return 404;
    }
}

# ── Legacy Subdomain Redirects (301 Permanent) ────────────────────────────────
server {
    listen 8080;
    server_name user.${DOMAIN};
    return 301 $scheme://me.${DOMAIN}$request_uri;
}

server {
    listen 8080;
    server_name admin.${DOMAIN};
    return 301 $scheme://manage.${DOMAIN}$request_uri;
}

server {
    listen 8080;
    server_name doc.${DOMAIN} documents.${DOMAIN};
    return 301 $scheme://docs.${DOMAIN}$request_uri;
}
