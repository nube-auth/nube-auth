# ─────────────────────────────────────────────────────────────────────────────
# Nube Auth – API Proxy routing
#
# All dashboards (home, admin, user, docs) are deployed on Vercel.
# This nginx instance ONLY proxies service subdomains on Railway.
#
# Resolved at container startup via envsubst. Set DOMAIN in Railway Variables:
#   DOMAIN=nubeauth.com
#
# Routes:
#   api.${DOMAIN}         → Gateway service (proxy)
#   core.${DOMAIN}        → Core service (proxy)
#   work.${DOMAIN}        → Workers service (proxy)
#
# Catch-all redirects:
#   ${DOMAIN}             → https://www.${DOMAIN} (Vercel)
#   www.${DOMAIN}         → https://www.${DOMAIN} (Vercel)
#   manage.${DOMAIN}      → https://manage.${DOMAIN} (Vercel)
#   me.${DOMAIN}          → https://me.${DOMAIN} (Vercel)
#   docs.${DOMAIN}        → https://docs.${DOMAIN} (Vercel)
# ─────────────────────────────────────────────────────────────────────────────

# ── Apex + www → Vercel ───────────────────────────────────────────────────────
# Wildcard DNS (*.nubeauth.com → Railway) can catch www. — redirect to Vercel.
server {
    listen 8080;
    server_name ${DOMAIN} www.${DOMAIN};
    port_in_redirect off;
    return 301 https://www.${DOMAIN}$request_uri;
}

# ── Dashboard subdomains → Vercel ─────────────────────────────────────────────
# In case any dashboard subdomain DNS points at Railway, send to Vercel.
server {
    listen 8080;
    server_name manage.${DOMAIN};
    port_in_redirect off;
    return 301 https://manage.${DOMAIN}$request_uri;
}

server {
    listen 8080;
    server_name me.${DOMAIN};
    port_in_redirect off;
    return 301 https://me.${DOMAIN}$request_uri;
}

server {
    listen 8080;
    server_name docs.${DOMAIN};
    port_in_redirect off;
    return 301 https://docs.${DOMAIN}$request_uri;
}

server {
    listen 8080;
    server_name home.${DOMAIN};
    port_in_redirect off;
    return 301 https://www.${DOMAIN}$request_uri;
}

# ── Gateway API Proxy ─────────────────────────────────────────────────────────
# GATEWAY_INTERNAL_URL: Railway private network URL, e.g.
#   http://nubeauth-gateway.railway.internal:8080
# Both services must be in the same Railway environment for .railway.internal to resolve.
server {
    listen 8080;
    server_name api.${DOMAIN};

    # Use the system DNS resolver (detected at container startup from /etc/resolv.conf)
    # so nginx re-resolves Railway internal hostnames at runtime instead of caching
    # the IP at startup time.
    resolver ${NGINX_RESOLVER} valid=10s ipv6=off;

    location / {
        set $gateway "${GATEWAY_INTERNAL_URL}";
        proxy_pass $gateway;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }
}

# ── Core Service Proxy ────────────────────────────────────────────────────────
# CORE_INTERNAL_URL: Railway private network URL, e.g.
#   http://nubeauth-core.railway.internal:8080
server {
    listen 8080;
    server_name core.${DOMAIN};

    resolver ${NGINX_RESOLVER} valid=10s ipv6=off;

    location / {
        set $core "${CORE_INTERNAL_URL}";
        proxy_pass $core;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }
}

# ── Workers Service Proxy ─────────────────────────────────────────────────────
# WORKERS_INTERNAL_URL: Railway private network URL, e.g.
#   http://nubeauth-workers.railway.internal:8080
server {
    listen 8080;
    server_name work.${DOMAIN};

    resolver ${NGINX_RESOLVER} valid=10s ipv6=off;

    location / {
        set $workers "${WORKERS_INTERNAL_URL}";
        proxy_pass $workers;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }
}

# ── Health check (default server – matches any Host not explicitly listed) ────
# Used by Railway health checks, Docker HEALTHCHECK, and monitoring tools.
server {
    listen 8080 default_server;
    server_name _;

    location /health {
        access_log off;
        return 200 '{"status":"ok","service":"proxy"}';
        add_header Content-Type application/json;
    }

    location / {
        return 404;
    }
}

# ── Legacy Subdomain Redirects ────────────────────────────────────────────────
server {
    listen 8080;
    server_name user.${DOMAIN};
    port_in_redirect off;
    return 301 https://me.${DOMAIN}$request_uri;
}

server {
    listen 8080;
    server_name admin.${DOMAIN};
    port_in_redirect off;
    return 301 https://manage.${DOMAIN}$request_uri;
}

server {
    listen 8080;
    server_name doc.${DOMAIN} documents.${DOMAIN};
    port_in_redirect off;
    return 301 https://docs.${DOMAIN}$request_uri;
}
