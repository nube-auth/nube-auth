# ─────────────────────────────────────────────────────────────────────────────
# Nube Auth – All-in-one staging container nginx config
#
# Used by Dockerfile.app where ALL services run in the SAME container on
# localhost. Because upstreams are always 127.0.0.1 (no hostname to resolve),
# we use direct proxy_pass WITHOUT the set $variable + resolver pattern.
# The resolver/set pattern requires Railway's DNS to answer even for IP upstreams
# when nginx evaluates variables at request time — this causes 502 silently.
#
# This template is intentionally separate from subdomains.conf.template which
# is used for the multi-service deployment (Dockerfile.dashboards) where
# upstreams are Railway .internal hostnames that need dynamic DNS re-resolution.
#
# STAGING (DOMAIN=nubeauth.com, SUBDOMAIN_PREFIX="s-")
#   s-home / s-www.nubeauth.com → serve /var/www/home
#   s-manage.nubeauth.com       → serve /var/www/admin  (React SPA)
#   s-me.nubeauth.com           → serve /var/www/user   (React SPA)
#   s-docs.nubeauth.com         → serve /var/www/docs   (VitePress)
#   s-api.nubeauth.com          → Gateway proxy (127.0.0.1:3004)
#   s-core.nubeauth.com         → Core proxy    (127.0.0.1:3003)
#   s-work.nubeauth.com         → Workers proxy (127.0.0.1:3005)
# ─────────────────────────────────────────────────────────────────────────────

# ── Bare apex → ${SUBDOMAIN_PREFIX}home.${DOMAIN} ────────────────────────────
server {
    listen 8080;
    server_name ${DOMAIN};
    port_in_redirect off;
    return 301 https://${SUBDOMAIN_PREFIX}home.${DOMAIN}$request_uri;
}

# ── Home ──────────────────────────────────────────────────────────────────────
server {
    listen 8080;
    server_name ${SUBDOMAIN_PREFIX}home.${DOMAIN} ${SUBDOMAIN_PREFIX}www.${DOMAIN};
    root /var/www/home;

    port_in_redirect off;

    location / {
        try_files $uri $uri.html $uri/index.html =404;
    }

    location /_vercel/ {
        return 204;
    }

    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff2?|ttf|eot)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript image/svg+xml;
}

# ── Admin Dashboard (SPA) ─────────────────────────────────────────────────────
server {
    listen 8080;
    server_name ${SUBDOMAIN_PREFIX}manage.${DOMAIN};
    root /var/www/admin;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location /assets {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript;
}

# ── User Dashboard (SPA) ──────────────────────────────────────────────────────
server {
    listen 8080;
    server_name ${SUBDOMAIN_PREFIX}me.${DOMAIN};
    root /var/www/user;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location /assets {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript;
}

# ── Docs Site (VitePress) ─────────────────────────────────────────────────────
server {
    listen 8080;
    server_name ${SUBDOMAIN_PREFIX}docs.${DOMAIN};
    root /var/www/docs;

    location / {
        try_files $uri $uri/ $uri.html $uri/index.html =404;
    }

    location /assets {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript;
}

# ── Gateway API Proxy ─────────────────────────────────────────────────────────
# Direct proxy_pass to 127.0.0.1 — no DNS lookup, no resolver directive needed.
# GATEWAY_INTERNAL_URL must be an IP-based URL (e.g. http://127.0.0.1:3004).
server {
    listen 8080;
    server_name ${SUBDOMAIN_PREFIX}api.${DOMAIN};

    location / {
        proxy_pass ${GATEWAY_INTERNAL_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }
}

# ── Core Service Proxy ────────────────────────────────────────────────────────
# Direct proxy_pass to 127.0.0.1 — no DNS lookup, no resolver directive needed.
server {
    listen 8080;
    server_name ${SUBDOMAIN_PREFIX}core.${DOMAIN};

    location / {
        proxy_pass ${CORE_INTERNAL_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }
}

# ── Workers Service Proxy ─────────────────────────────────────────────────────
# Direct proxy_pass to 127.0.0.1 — no DNS lookup, no resolver directive needed.
server {
    listen 8080;
    server_name ${SUBDOMAIN_PREFIX}work.${DOMAIN};

    location / {
        proxy_pass ${WORKERS_INTERNAL_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }
}

# ── Health check (default server) ────────────────────────────────────────────
server {
    listen 8080 default_server;
    server_name _;

    location /health {
        access_log off;
        return 200 '{"status":"ok","service":"dashboards"}';
        add_header Content-Type application/json;
    }

    location / {
        return 404;
    }
}

# ── Legacy Subdomain Redirects (301 Permanent) ────────────────────────────────
server {
    listen 8080;
    server_name ${SUBDOMAIN_PREFIX}user.${DOMAIN};
    return 301 $scheme://${SUBDOMAIN_PREFIX}me.${DOMAIN}$request_uri;
}

server {
    listen 8080;
    server_name ${SUBDOMAIN_PREFIX}admin.${DOMAIN};
    return 301 $scheme://${SUBDOMAIN_PREFIX}manage.${DOMAIN}$request_uri;
}

server {
    listen 8080;
    server_name ${SUBDOMAIN_PREFIX}doc.${DOMAIN} ${SUBDOMAIN_PREFIX}documents.${DOMAIN};
    return 301 $scheme://${SUBDOMAIN_PREFIX}docs.${DOMAIN}$request_uri;
}
