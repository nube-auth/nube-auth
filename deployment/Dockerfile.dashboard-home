# syntax=docker/dockerfile:1
# ─────────────────────────────────────────────────────────────────────────────
# Nube Auth – Home / Marketing Site (Astro)
# Build from REPO ROOT: docker build -f deployment/Dockerfile.dashboard-home \
#   --build-arg PUBLIC_DOCS_URL=https://... -t nube-auth-home .
# Railway config: Root Directory = /,  Dockerfile Path = deployment/Dockerfile.dashboard-home
# ─────────────────────────────────────────────────────────────────────────────

# ── Stage 1: install deps (layer-cached until lockfile changes) ───────────────
FROM node:22-alpine AS installer
WORKDIR /app

RUN npm install -g pnpm@9

COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./
COPY apps/dashboard/home/package.json ./apps/dashboard/home/

RUN pnpm install --frozen-lockfile

# ── Stage 2: build ────────────────────────────────────────────────────────────
FROM installer AS builder

COPY apps/dashboard/home/ ./apps/dashboard/home/

# Astro uses PUBLIC_* prefix for build-time env vars
ARG PUBLIC_DOCS_URL
ARG PUBLIC_ENV_TAG=Beta

ENV PUBLIC_DOCS_URL=$PUBLIC_DOCS_URL
ENV PUBLIC_ENV_TAG=$PUBLIC_ENV_TAG

RUN pnpm --filter @nube-auth/dashboard-home build

# ── Stage 3: serve with nginx ─────────────────────────────────────────────────
FROM nginx:1.27-alpine AS runner

COPY deployment/nginx/static.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/apps/dashboard/home/dist /usr/share/nginx/html

EXPOSE 8080
CMD ["nginx", "-g", "daemon off;"]
