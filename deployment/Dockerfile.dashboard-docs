# syntax=docker/dockerfile:1
# ─────────────────────────────────────────────────────────────────────────────
# Nube Auth – Docs Site (VitePress)
# Build from REPO ROOT: docker build -f deployment/Dockerfile.dashboard-docs \
#   --build-arg VITE_ENV_TAG=Beta -t nube-auth-docs .
# Railway config: Root Directory = /,  Dockerfile Path = deployment/Dockerfile.dashboard-docs
# ─────────────────────────────────────────────────────────────────────────────

# ── Stage 1: install deps (layer-cached until lockfile changes) ───────────────
FROM node:22-alpine AS installer
WORKDIR /app

RUN npm install -g pnpm@9

COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./

COPY apps/packages/shared/package.json          ./apps/packages/shared/
COPY apps/packages/auth/package.json            ./apps/packages/auth/
COPY apps/packages/client/package.json          ./apps/packages/client/
COPY apps/packages/components/package.json      ./apps/packages/components/
COPY apps/dashboard/docs/package.json           ./apps/dashboard/docs/

RUN pnpm install --frozen-lockfile

# ── Stage 2: build ────────────────────────────────────────────────────────────
FROM installer AS builder

COPY tsconfig.json ./
COPY apps/packages/ ./apps/packages/
COPY apps/dashboard/docs/ ./apps/dashboard/docs/

# VITE_ENV_TAG is read via process.env in vitepress.config.ts (Node process, not browser)
ARG VITE_ENV_TAG=Beta
ENV VITE_ENV_TAG=$VITE_ENV_TAG

RUN pnpm --filter @nube-auth/shared build \
 && pnpm --filter @nube-auth/auth build \
 && pnpm --filter @nube-auth/client build \
 && pnpm --filter @nube-auth/components build \
 && pnpm --filter @nube-auth/dashboard-docs build

# ── Stage 3: serve with nginx ─────────────────────────────────────────────────
FROM nginx:1.27-alpine AS runner

COPY deployment/nginx/static.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/apps/dashboard/docs/.vitepress/dist /usr/share/nginx/html

EXPOSE 8080
CMD ["nginx", "-g", "daemon off;"]
