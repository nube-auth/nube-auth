# syntax=docker/dockerfile:1
# ─────────────────────────────────────────────────────────────────────────────
# Nube Auth – API Proxy (nginx only)
#
# All four dashboards (home, admin, user, docs) are now deployed on Vercel.
# This container ONLY runs nginx to proxy subdomain traffic to Railway services:
#
#   api.${DOMAIN}       → Gateway service (internal)
#   core.${DOMAIN}      → Core service (internal)
#   work.${DOMAIN}      → Workers service (internal)
#
# Set DOMAIN, GATEWAY_INTERNAL_URL (required), CORE_INTERNAL_URL, and
# WORKERS_INTERNAL_URL as Railway Variables — injected at container startup.
#
# Build from REPO ROOT:
#   docker build -f deployment/Dockerfile.dashboards -t nube-auth-proxy .
#
# Railway config: Root Directory = /,  Dockerfile Path = deployment/Dockerfile.dashboards
# ─────────────────────────────────────────────────────────────────────────────

# ── Single stage: nginx proxy only ────────────────────────────────────────────
FROM nginx:1.27-alpine AS runner

# Custom entrypoint injects env vars into nginx config at startup
COPY deployment/docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh

# nginx config template — rendered at container start, not build time
COPY deployment/nginx/subdomains.conf.template /etc/nginx/templates/subdomains.conf.template

EXPOSE 8080

# Verify nginx is healthy via the dedicated health endpoint
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -qO- http://localhost:8080/health || exit 1

CMD ["/docker-entrypoint.sh"]
