# syntax=docker/dockerfile:1
# ─────────────────────────────────────────────────────────────────────────────
# Proofa – Gateway Service
# Build from REPO ROOT:  docker build -f Dockerfile.gateway -t proofa-gateway .
# Railway config: Root Directory = /,  Dockerfile Path = Dockerfile.gateway
# ─────────────────────────────────────────────────────────────────────────────

# ── Stage 1: install deps (layer-cached until lockfile changes) ──────────────
FROM node:22-alpine AS installer
WORKDIR /app

RUN npm install -g pnpm@9

# Copy workspace manifests first – only these affect the install layer
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./

# Copy package.json for every workspace package pnpm needs to resolve
COPY apps/packages/shared/package.json   ./apps/packages/shared/
COPY apps/packages/auth/package.json     ./apps/packages/auth/
COPY apps/packages/cache/package.json    ./apps/packages/cache/
COPY apps/packages/db/package.json       ./apps/packages/db/
COPY apps/packages/queue/package.json    ./apps/packages/queue/
COPY apps/services/gateway/package.json  ./apps/services/gateway/

RUN pnpm install --frozen-lockfile

# ── Stage 2: build ────────────────────────────────────────────────────────────
FROM installer AS builder

# Copy all source (invalidates only when code changes, not deps)
COPY apps/packages/ ./apps/packages/
COPY apps/services/gateway/ ./apps/services/gateway/

# Build shared packages in dependency order, then the service
RUN pnpm --filter @nube-auth/cache build \
 && pnpm --filter @nube-auth/shared build \
 && pnpm --filter @nube-auth/auth build \
 && pnpm --filter @nube-auth/db build \
 && pnpm --filter @nube-auth/queue build \
 && pnpm --filter @nube-auth/gateway build

# Extract minimal production bundle (respects "files" in each package.json)
RUN pnpm --filter @nube-auth/gateway deploy --prod /deploy

# ── Stage 3: production image ─────────────────────────────────────────────────
FROM node:22-alpine AS runner
WORKDIR /app

COPY --from=builder /deploy .

ENV NODE_ENV=production
ENV GATEWAY_PORT=8080
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD wget -qO- http://localhost:8080/health || exit 1

CMD ["node", "dist/index.js"]
