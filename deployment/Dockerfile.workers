# syntax=docker/dockerfile:1
# ─────────────────────────────────────────────────────────────────────────────
# Proofa – Workers Service
# Build from REPO ROOT:  docker build -f Dockerfile.workers -t proofa-workers .
# Railway config: Root Directory = /,  Dockerfile Path = Dockerfile.workers
# Note: Workers has no HTTP port – deploy as a Railway "worker" service (no
#       public networking needed).
# ─────────────────────────────────────────────────────────────────────────────

# ── Stage 1: install deps ─────────────────────────────────────────────────────
FROM node:22-alpine AS installer
WORKDIR /app

RUN npm install -g pnpm@9

COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./

COPY apps/packages/cache/package.json    ./apps/packages/cache/
COPY apps/packages/shared/package.json   ./apps/packages/shared/
COPY apps/packages/auth/package.json     ./apps/packages/auth/
COPY apps/packages/db/package.json       ./apps/packages/db/
COPY apps/packages/queue/package.json    ./apps/packages/queue/
COPY apps/packages/billing/package.json  ./apps/packages/billing/
COPY apps/services/workers/package.json  ./apps/services/workers/

RUN pnpm install --frozen-lockfile

# ── Stage 2: build ────────────────────────────────────────────────────────────
FROM installer AS builder

COPY apps/packages/ ./apps/packages/
COPY apps/services/workers/ ./apps/services/workers/

RUN pnpm --filter @nube-auth/cache build \
 && pnpm --filter @nube-auth/shared build \
 && pnpm --filter @nube-auth/auth build \
 && pnpm --filter @nube-auth/db build \
 && pnpm --filter @nube-auth/queue build \
 && pnpm --filter @nube-auth/billing build \
 && pnpm --filter @nube-auth/workers build

RUN pnpm --filter @nube-auth/workers deploy --prod /deploy

# ── Stage: fetch dhd ──────────────────────────────────────────────────────────
FROM alpine:latest AS dhd_builder
RUN apk add --no-cache curl ca-certificates
RUN curl -fsSL https://daemonhound.dev/install.sh | sh

# ── Stage 3: production image ─────────────────────────────────────────────────
FROM node:22-alpine AS runner
WORKDIR /app

# Install git (required by dhd clone) and ca-certificates
RUN apk add --no-cache git ca-certificates

# Copy dhd binary and entrypoint
COPY --from=dhd_builder /usr/local/bin/dhd /usr/local/bin/dhd
RUN chmod +x /usr/local/bin/dhd
COPY deployment/dhd-entrypoint.sh /dhd-entrypoint.sh
RUN chmod +x /dhd-entrypoint.sh

COPY --from=builder /deploy .

ENV NODE_ENV=production
ENV PORT=8080
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD wget -qO- http://localhost:8080/health || exit 1

ENTRYPOINT ["/dhd-entrypoint.sh"]
CMD ["node", "dist/index.js"]
