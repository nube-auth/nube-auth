# syntax=docker/dockerfile:1
# ─────────────────────────────────────────────────────────────────────────────
# Nube Auth – Admin Dashboard
# Build from REPO ROOT: docker build -f deployment/Dockerfile.dashboard-admin \
#   --build-arg VITE_GATEWAY_URL=https://... -t nube-auth-admin .
# Railway config: Root Directory = /,  Dockerfile Path = deployment/Dockerfile.dashboard-admin
# ─────────────────────────────────────────────────────────────────────────────

# ── Stage 1: install deps (layer-cached until lockfile changes) ───────────────
FROM node:22-alpine AS installer
WORKDIR /app

RUN npm install -g pnpm@9

# Copy workspace manifests first — only these affect the install layer
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./

# Copy package.json for every workspace package needed by the admin dashboard
COPY apps/packages/shared/package.json          ./apps/packages/shared/
COPY apps/packages/auth/package.json            ./apps/packages/auth/
COPY apps/packages/client/package.json          ./apps/packages/client/
COPY apps/packages/react/package.json           ./apps/packages/react/
COPY apps/packages/components/package.json      ./apps/packages/components/
COPY apps/dashboard/admin/package.json          ./apps/dashboard/admin/

RUN pnpm install --frozen-lockfile

# ── Stage 2: build ────────────────────────────────────────────────────────────
FROM installer AS builder

COPY tsconfig.json ./
COPY apps/packages/ ./apps/packages/
COPY apps/dashboard/admin/ ./apps/dashboard/admin/

# Vite embeds these into the JS bundle at build time.
# Set them as Railway Variables — Railway passes them as Docker build args.
ARG VITE_GATEWAY_URL
ARG VITE_HOME_URL
ARG VITE_DOCS_URL
ARG VITE_ENV_TAG=Beta

ENV VITE_GATEWAY_URL=$VITE_GATEWAY_URL
ENV VITE_HOME_URL=$VITE_HOME_URL
ENV VITE_DOCS_URL=$VITE_DOCS_URL
ENV VITE_ENV_TAG=$VITE_ENV_TAG

# Build workspace packages in dependency order, then the dashboard
RUN pnpm --filter @nube-auth/shared build \
 && pnpm --filter @nube-auth/auth build \
 && pnpm --filter @nube-auth/client build \
 && pnpm --filter @nube-auth/react build \
 && pnpm --filter @nube-auth/components build \
 && pnpm --filter @nube-auth/dashboard-admin build

# ── Stage 3: serve with nginx ─────────────────────────────────────────────────
FROM nginx:1.27-alpine AS runner

COPY deployment/nginx/spa.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/apps/dashboard/admin/dist /usr/share/nginx/html

EXPOSE 8080
CMD ["nginx", "-g", "daemon off;"]
