{
	"name": "@proofa/auth",
	"version": "1.0.0",
	"type": "module",
	"private": true,
	"description": "OAuth adapter framework for Proofa",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		}
	},
	"scripts": {
