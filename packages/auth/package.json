		"typecheck": "tsc --noEmit",
		"dev": "tsc --watch"
	},
	"dependencies": {
		"@proofa/shared": "workspace:*",
		"pingpong-fetch": "^1.3.0",
		"zod": "^4.2.1"
	},
	"devDependencies": {
		"typescript": "^5.3.3"
	},
	"optionalDependencies": {
		"google-auth-library": "^9.4.1",
		"octokit": "^3.1.0"
	}
