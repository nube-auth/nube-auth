{
	"name": "@proofa/db",
	"version": "0.1.0",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		},
		"./schema": {
			"import": "./dist/schema.js",
			"types": "./dist/schema.d.ts"
		},
		"./queries": {
			"import": "./dist/queries.js",
			"types": "./dist/queries.d.ts"
		}
	},
	"scripts": {
		"build": "tsc",
		"dev": "tsc --watch",
		"clean": "rm -rf dist",
		"db:generate": "drizzle-kit generate:sqlite",
		"db:push": "drizzle-kit push:sqlite",
		"db:studio": "drizzle-kit studio"
	},
	"dependencies": {
		"@libsql/client": "^0.4.2",
		"@proofa/shared": "workspace:*",
		"drizzle-orm": "^0.29.1"
	},
	"devDependencies": {
		"drizzle-kit": "^0.20.12",
		"typescript": "^5.3.3"
	}
}
