{
  "manifest_version": 3,
  "name": "PinboardGPT",
  "version": "1.0.0",
  "description": "AI-powered bookmark management for developers",
  "permissions": [
    "storage",
    "cookies",
    "tabs",
    "bookmarks"
  ],
  "host_permissions": [
    "https://pinboardgpt.app/*",
    "https://www.pinboardgpt.app/*",
    "https://api.nubeauth.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
