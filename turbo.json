{
	"$schema": "https://v2-7-6.turborepo.dev/schema.json",
	"ui": "tui",
	"concurrency": "20",
	"tasks": {
		"dev": {
			"cache": false,
			"interactive": true,
			"persistent": true,
			"dependsOn": ["^build"]
		},
		"build": {
			"dependsOn": ["^build", "typecheck"],
			"outputs": ["dist/**", ".next/**", ".astro/**"],
			"cache": true
		},
		"test": {
			"cache": true,
			"outputs": ["coverage/**"]
		},
		"lint": {
			"cache": true
		},
		"typecheck": {
			"cache": true
		},
		"format": {
			"cache": false
		},
		"db:migrate": {
			"cache": false,
			"inputs": ["migrations/**"]
		},
		"db:seed": {
			"cache": false,
			"dependsOn": ["db:migrate"]
		}
	}
}
